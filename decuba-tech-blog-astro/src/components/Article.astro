---
import { renderArticleHtml } from '../lib/article-html.js';
const { data, series = null } = Astro.props;
const title = data.title;
const date = new Date(data.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const bodyHtml = renderArticleHtml(data.bodyHtml);
---
<article class="article"><header class="article-header"><div class="article-meta">{data.primaryCategory || data.category} · {date}</div><h1>{title}</h1><p class="article-dek">{data.description}</p><div class="article-tags">{series ? <a class="article-series-link" href={`/series/${series.id}/`}>{series.title} · Episode {series.number}</a> : <span>{data.series ? `Series: ${data.series}${data.seriesOrder ? ` · Episode ${data.seriesOrder}` : ''}` : 'Field note'}</span>}<span>Level: {data.level}</span>{data.tags.map((tag)=><span>#{tag}</span>)}</div></header><div class="article-body">{data.bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />}</div>{series && <nav class="episode-navigation" aria-label="Series navigation"><div class="episode-overview"><span class="meta">Episode {series.number} · {series.position} of {series.posts.length} published</span><a href={`/series/${series.id}/`}>View the series: {series.title}</a></div><div class="episode-adjacent">{series.previous && <a rel="prev" href={`/posts/${series.previous.id}/`}><span>Previous episode</span><strong>{series.previous.data.title}</strong></a>}{series.next && <a rel="next" href={`/posts/${series.next.id}/`}><span>Next episode</span><strong>{series.next.data.title}</strong></a>}</div></nav>}</article><dialog class="image-viewer" aria-label="Enlarged image"><button class="image-viewer-close" type="button" aria-label="Close enlarged image">×</button><img src="" alt="" /></dialog>
<script>
const article = document.querySelector('.article');
const viewer = document.querySelector('.image-viewer');
const viewerImage = viewer?.querySelector('img');
const closeButton = viewer?.querySelector('.image-viewer-close');
let sourceImage;

const openViewer = (image) => {
  if (!(viewer instanceof HTMLDialogElement) || !(viewerImage instanceof HTMLImageElement)) return;
  sourceImage = image;
  viewerImage.src = image.currentSrc || image.src;
  viewerImage.alt = image.alt || '';
  viewer.showModal();
  document.documentElement.classList.add('image-viewer-open');
  closeButton?.focus();
};

const prepareImages = () => article?.querySelectorAll('img').forEach((image) => {
  image.tabIndex = 0;
  image.setAttribute('role', 'button');
  image.setAttribute('aria-label', image.alt ? `Enlarge image: ${image.alt}` : 'Enlarge image');
});
prepareImages();
if (article) new MutationObserver(prepareImages).observe(article, { childList: true, subtree: true });
article?.addEventListener('click', (event) => {
  if (event.target instanceof HTMLImageElement) openViewer(event.target);
});
article?.addEventListener('keydown', (event) => {
  if (event.target instanceof HTMLImageElement && (event.key === 'Enter' || event.key === ' ')) {
    event.preventDefault();
    openViewer(event.target);
  }
});

closeButton?.addEventListener('click', () => viewer?.close());
viewer?.addEventListener('click', (event) => {
  if (event.target === viewer) viewer.close();
});
viewer?.addEventListener('close', () => {
  document.documentElement.classList.remove('image-viewer-open');
  sourceImage?.focus();
});
</script>
<style is:global>.article{width:100%;max-width:1080px;margin:0 auto}.article-header{max-width:900px;margin-bottom:3rem}.article h1{font-size:clamp(2rem,3.5vw,3rem);line-height:1.15;letter-spacing:-.035em;max-width:28ch;margin:.8rem 0 1.2rem;text-wrap:balance;overflow-wrap:anywhere}.article-dek{max-width:760px;color:var(--muted);font-size:1.2rem;line-height:1.7;margin:0 0 1.6rem}.article-tags{display:flex;gap:.55rem;flex-wrap:wrap;color:var(--accent);font:500 .68rem 'IBM Plex Mono',monospace;text-transform:uppercase}.article-tags span{padding:.45rem .6rem;border-radius:2rem;background:var(--accent-soft)}.article-body{width:100%;max-width:none;color:var(--muted);font-size:1.08rem;line-height:1.85}.article-body p,.article-body ul,.article-body ol,.article-body blockquote,.article-body pre{width:100%;max-width:820px}.article-body h2,.article-body h3{max-width:820px}.article-body img{display:block;width:100%;max-width:100%;height:auto;max-height:760px;object-fit:contain;margin:2rem auto;border-radius:.75rem}.article-body figure{width:100%;margin:2rem 0}.article-body figcaption{text-align:center;color:var(--muted);font-size:.8rem;margin-top:.5rem}.article-body blockquote{border-left:3px solid var(--accent);padding:1rem 1.25rem;background:var(--panel);color:var(--muted)}.article-body pre{overflow:auto;padding:1.2rem;border-radius:.75rem;background:#101827;color:#e6edf7;border:1px solid var(--line)}.article img[role='button']{cursor:zoom-in}.article img[role='button']:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.image-viewer{width:100vw;height:100vh;max-width:none;max-height:none;margin:0;padding:clamp(1rem,4vw,3rem);border:0;background:rgba(5,10,20,.94);overflow:hidden}.image-viewer[open]{display:grid;place-items:center}.image-viewer::backdrop{background:rgba(5,10,20,.94)}.image-viewer img{display:block;max-width:100%;max-height:calc(100vh - clamp(2rem,8vw,6rem));object-fit:contain}.image-viewer-close{position:fixed;z-index:1;top:clamp(.75rem,2vw,1.5rem);right:clamp(.75rem,2vw,1.5rem);display:grid;width:2.75rem;height:2.75rem;padding:0;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:rgba(5,10,20,.72);color:#fff;font-size:2rem;line-height:1;cursor:pointer}.image-viewer-close:hover,.image-viewer-close:focus-visible{background:#fff;color:#07101f}.image-viewer-close:focus-visible{outline:3px solid #78aaff;outline-offset:3px}html.image-viewer-open{overflow:hidden}@media(max-width:760px){.article-body img{max-height:none}}
</style>

<style is:global>
.article-body [data-table-scroll]{max-width:100%;overflow-x:auto;margin:1.5rem 0;outline-offset:3px}
.article-body table{width:100%;min-width:480px;border-collapse:collapse;text-align:left}
.article-body td,.article-body th{border:1px solid var(--line);padding:.7rem .9rem;vertical-align:top;overflow-wrap:anywhere}
.article-body th{background:var(--accent-soft);color:var(--ink);font-weight:700}
.article-body td p,.article-body th p{margin:.25em 0}
</style>

<style is:global>
.article-series-link{color:var(--accent);text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.episode-navigation{margin-top:3rem;padding:1.5rem;border:1px solid var(--line);border-radius:.75rem;background:var(--panel)}.episode-overview{display:grid;gap:.75rem}.episode-overview>a{font-weight:700;line-height:1.5;color:var(--accent)}.episode-adjacent{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.25rem}.episode-adjacent:empty{display:none}.episode-adjacent>a{display:grid;gap:.5rem;padding:1rem;border:1px solid var(--line);border-radius:.5rem;line-height:1.5;min-width:0;overflow-wrap:anywhere}.episode-adjacent>a:hover{border-color:var(--accent)}.episode-adjacent span{color:var(--muted);font-size:.8rem}.episode-adjacent strong{font-size:.95rem}.episode-navigation a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(max-width:600px){.episode-adjacent{grid-template-columns:1fr}.episode-navigation{padding:1.1rem}}
</style>
