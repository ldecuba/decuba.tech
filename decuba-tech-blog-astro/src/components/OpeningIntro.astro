<div class="opening-intro" role="dialog" aria-label="decuba.tech introduction">
  <button class="intro-skip" type="button">Skip intro</button>
  <div class="intro-stage" aria-hidden="true">
    <div class="data-grid"></div>
    <div class="network">
      <span class="node n1"></span><span class="node n2"></span><span class="node n3"></span>
      <span class="node n4"></span><span class="node n5"></span><span class="node n6"></span>
      <i class="line l1"></i><i class="line l2"></i><i class="line l3"></i><i class="line l4"></i><i class="line l5"></i>
    </div>
    <div class="scan-line"></div>
  </div>
  <div class="intro-copy">
    <span class="intro-label">System / online</span>
    <img src="/images/decuba-logo.png" alt="decuba.tech" />
    <p>A personal tech blog</p>
    <div class="intro-status"><span>Connect</span><span>Process</span><span>Ready</span></div>
  </div>
  <div class="intro-progress" aria-hidden="true"><span></span></div>
</div>

<script>
const intro=document.querySelector('.opening-intro');
if(intro){
  document.documentElement.classList.add('intro-active');
  const close=()=>{if(intro.classList.contains('is-closing'))return;intro.classList.add('is-closing');document.documentElement.classList.remove('intro-active');setTimeout(()=>intro.remove(),850)};
  intro.querySelector('.intro-skip')?.addEventListener('click',close);
  setTimeout(close,4200);
}
</script>

<style is:global>
html.intro-active,html.intro-active body{overflow:hidden}.opening-intro{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#07101f;color:#fff;overflow:hidden;isolation:isolate}.opening-intro:after{content:'';position:absolute;inset:0;z-index:5;background:#f7f9fc;transform:translateY(100%)}.opening-intro.is-closing:after{animation:curtain .85s cubic-bezier(.76,0,.24,1) both}.opening-intro.is-closing{pointer-events:none}.intro-stage{position:absolute;inset:0;overflow:hidden;background:radial-gradient(circle at 50% 52%,#153d79 0,rgba(12,33,66,.74) 22%,rgba(7,16,31,0) 52%)}.data-grid{position:absolute;inset:-20%;background-image:linear-gradient(rgba(105,157,239,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(105,157,239,.12) 1px,transparent 1px);background-size:58px 58px;transform:perspective(700px) rotateX(64deg) translateY(24%);animation:grid-travel 4.2s linear both}.network{position:absolute;left:50%;top:48%;width:min(700px,88vw);height:min(420px,55vh);transform:translate(-50%,-50%)}.node{position:absolute;width:12px;height:12px;border:2px solid #8ab7ff;border-radius:50%;background:#07101f;box-shadow:0 0 0 0 rgba(88,145,239,.7);animation:node-on .55s both,pulse 1.5s 1.2s infinite}.n1{left:8%;top:28%;animation-delay:.2s}.n2{left:28%;top:68%;animation-delay:.45s}.n3{left:48%;top:20%;width:20px;height:20px;animation-delay:.7s}.n4{left:67%;top:62%;animation-delay:.95s}.n5{left:88%;top:30%;animation-delay:1.2s}.n6{left:49%;top:78%;animation-delay:1.45s}.line{position:absolute;height:1px;background:linear-gradient(90deg,transparent,#6ea4fa 18%,#6ea4fa 82%,transparent);transform-origin:left;opacity:.65;animation:draw-line .7s both}.l1{left:9%;top:30%;width:38%;transform:rotate(24deg);animation-delay:.4s}.l2{left:29%;top:69%;width:31%;transform:rotate(-52deg);animation-delay:.7s}.l3{left:50%;top:22%;width:40%;transform:rotate(13deg);animation-delay:1s}.l4{left:50%;top:23%;width:45%;transform:rotate(64deg);animation-delay:1.25s}.l5{left:50%;top:80%;width:23%;transform:rotate(-35deg);animation-delay:1.5s}.scan-line{position:absolute;left:0;right:0;height:2px;top:-2px;background:linear-gradient(90deg,transparent,#78aaff,transparent);box-shadow:0 0 24px #4c8df6;animation:scan 2.2s .3s ease-in-out both}.intro-copy{position:relative;z-index:3;width:min(520px,78vw);text-align:center}.intro-label{display:block;margin-bottom:1.2rem;color:#9dbcea;font:500 .65rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.2em;animation:copy-in .6s .2s both}.intro-copy img{display:block;width:min(330px,70vw);height:auto;margin:auto;filter:brightness(0) invert(1);animation:logo-in .8s .45s cubic-bezier(.2,.8,.2,1) both}.intro-copy p{margin:1.1rem 0 1.8rem;color:#d8e5f8;font:500 .78rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.19em;animation:copy-in .6s .9s both}.intro-status{display:flex;justify-content:center;gap:1.4rem;color:#6980a2;font:500 .6rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.12em}.intro-status span{animation:status-on .35s both}.intro-status span:nth-child(1){animation-delay:1.3s}.intro-status span:nth-child(2){animation-delay:2s}.intro-status span:nth-child(3){animation-delay:2.8s}.intro-skip{position:absolute;z-index:10;top:1.5rem;right:1.5rem;border:1px solid #354968;border-radius:2rem;background:rgba(7,16,31,.7);color:#afbdd2;padding:.58rem .85rem;font-size:.7rem;font-weight:700;cursor:pointer}.intro-skip:hover{color:#fff;border-color:#7ba8ee}.intro-progress{position:absolute;z-index:4;left:50%;bottom:clamp(2rem,7vh,4.5rem);width:min(320px,66vw);height:2px;transform:translateX(-50%);background:#263853;overflow:hidden}.intro-progress span{display:block;height:100%;background:#78aaff;transform-origin:left;animation:load 3.8s .2s cubic-bezier(.2,.8,.2,1) both}@keyframes grid-travel{from{background-position:0 0}to{background-position:0 232px}}@keyframes scan{0%{top:0;opacity:0}12%{opacity:1}88%{opacity:1}100%{top:100%;opacity:0}}@keyframes node-on{from{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}@keyframes pulse{50%{box-shadow:0 0 0 9px rgba(88,145,239,0)}}@keyframes draw-line{from{opacity:0;scale:0 1}to{opacity:.65;scale:1 1}}@keyframes logo-in{from{opacity:0;transform:scale(.88);filter:blur(12px) brightness(0) invert(1)}to{opacity:1;transform:none;filter:blur(0) brightness(0) invert(1)}}@keyframes copy-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes status-on{from{color:#6980a2}to{color:#a9c9ff;text-shadow:0 0 14px #4385ed}}@keyframes load{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes curtain{0%{transform:translateY(100%)}55%,100%{transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.opening-intro{display:none}html.intro-active,html.intro-active body{overflow:auto}}
</style>
