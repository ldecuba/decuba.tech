---
const { title = 'decuba.tech' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | decuba.tech</title>
    <meta name="description" content="Personal notes on Microsoft cloud, AI and the work around it." />
  </head>
  <body>
    <div class="site-shell">
      <aside class="side-rail"><a href="/" class="rail-brand"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><span class="rail-word">FIELD NOTES<br />BY LISANDRO</span><span class="rail-year">MMXXVI</span></aside>
      <div class="page">
        <header class="site-header"><a href="/" class="mobile-brand"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><div class="issue">Issue 01 <span>/</span> Working notes from the cloud</div><nav><a href="/category/ai">AI</a><a href="/category/microsoft">Microsoft</a><a href="/about">About</a></nav></header>
        <main><slot /></main>
        <footer><div class="footer-mark"><img src="/images/decuba-logo.png" alt="decuba.tech" /><span>Personal technology writing<br />from the messy middle.</span></div><div class="footer-links"><a href="/about">About</a><a href="/">Index</a><small>Copyright © {new Date().getFullYear()} decuba.tech · Written by Lisandro de Cuba</small></div></footer>
      </div>
    </div>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Instrument+Serif:ital@0;1&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#17191b;background:#f1ede5;--ink:#17191b;--muted:#6c6a64;--red:#e34d35;--blue:#234f9a;--line:#c9c2b6}*{box-sizing:border-box}body{margin:0;min-width:320px}.site-shell{display:grid;grid-template-columns:88px 1fr;min-height:100vh}.side-rail{background:var(--red);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:1.2rem .8rem 1.4rem;position:sticky;top:0;height:100vh}.rail-brand img{width:54px;filter:brightness(0) invert(1)}.rail-word,.rail-year{font:500 .62rem 'DM Mono',monospace;letter-spacing:.08em;writing-mode:vertical-rl;transform:rotate(180deg)}.rail-year{font-size:.7rem}.page{max-width:1500px;width:100%}.site-header{min-height:78px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:1.1rem clamp(1.25rem,4vw,4.5rem);gap:2rem}.mobile-brand{display:none}.issue,nav{font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.04em}.issue span{color:var(--red);padding:0 .5rem}nav{display:flex;gap:1.4rem}a{color:inherit;text-decoration:none}nav a:hover,.footer-links a:hover{color:var(--red)}main{padding:clamp(3rem,7vw,7rem) clamp(1.25rem,7vw,8rem) 8rem}.hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.55fr);gap:5rem;align-items:end;border-bottom:2px solid var(--ink);padding-bottom:4rem}.kicker,.meta{font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--red)}.hero h1{font:400 clamp(4rem,10vw,10rem) 'Instrument Serif',serif;line-height:.84;letter-spacing:-.04em;margin:1.1rem 0 1.5rem;max-width:8ch}.hero h1 em{color:var(--blue)}.hero p{font-size:1.15rem;line-height:1.55;max-width:33rem;color:var(--muted);margin:0}.hero-aside{border-left:1px solid var(--line);padding-left:1.4rem;color:var(--muted);font-size:.9rem;line-height:1.6}.hero-aside strong{display:block;color:var(--ink);font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:.8rem}.section-label{font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;margin:3.5rem 0 1rem;color:var(--blue)}.posts{border-top:1px solid var(--ink)}.post{display:grid;grid-template-columns:10rem minmax(0,1fr) 11rem;gap:2rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--line)}.post h2{font:400 clamp(1.8rem,3.4vw,3.6rem) 'Instrument Serif',serif;line-height:.95;margin:0;max-width:18ch}.post p{color:var(--muted);line-height:1.5;margin:.35rem 0 0}.read{font:500 .72rem 'DM Mono',monospace;text-transform:uppercase;color:var(--blue);justify-self:end;border-bottom:1px solid var(--blue);padding-bottom:.25rem;margin-top:.3rem}.read:hover{color:var(--red);border-color:var(--red)}article{max-width:900px;margin:auto}.article-meta{color:var(--red);font:500 .72rem 'DM Mono',monospace}.article h1,article h1{font:400 clamp(3.5rem,8vw,8rem) 'Instrument Serif',serif;line-height:.88;letter-spacing:-.04em;max-width:9ch;margin:1rem 0 3rem}.article-body{font-size:1.12rem;line-height:1.75;max-width:680px;color:#4d4b46}.article-body h2{font:400 2.7rem 'Instrument Serif',serif;color:var(--ink);margin-top:3rem}.article-body strong{color:var(--ink)}footer{border-top:2px solid var(--ink);padding:1.4rem clamp(1.25rem,7vw,8rem) 2rem;display:flex;justify-content:space-between;gap:2rem;font-size:.85rem;color:var(--muted)}.footer-mark{display:flex;gap:1rem;align-items:flex-start}.footer-mark img{width:125px;height:auto}.footer-links{display:flex;gap:1rem;align-items:flex-start;flex-wrap:wrap;justify-content:flex-end}.footer-links small{flex-basis:100%;text-align:right;font:400 .65rem 'DM Mono',monospace}.intro{max-width:800px}.intro h1{font:400 clamp(4rem,9vw,9rem) 'Instrument Serif',serif;line-height:.86;max-width:9ch}.intro p{font-size:1.15rem;line-height:1.6;color:var(--muted)}
@media(max-width:760px){.site-shell{display:block}.side-rail{display:none}.site-header{min-height:70px;padding:1rem 1.25rem}.mobile-brand{display:block}.mobile-brand img{width:120px;height:auto}.issue{display:none}nav{gap:.8rem;font-size:.63rem}main{padding:3.5rem 1.25rem 5rem}.hero{display:block;padding-bottom:2.5rem}.hero h1{font-size:clamp(4.3rem,19vw,8rem)}.hero-aside{margin-top:2.5rem}.post{grid-template-columns:1fr;gap:.7rem;padding:1.25rem 0}.post h2{font-size:2.5rem}.read{justify-self:start;margin-top:.5rem}footer{display:block;padding:1.5rem 1.25rem 2rem}.footer-links{justify-content:flex-start;margin-top:2rem}.footer-links small{text-align:left}}
</style>
