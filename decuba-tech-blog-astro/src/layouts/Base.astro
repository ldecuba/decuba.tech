---
const { title = 'decuba.tech' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title} | decuba.tech</title><meta name="description" content="Personal notes on Microsoft cloud, AI and the work around it." /></head><body><div class="site-shell"><aside class="side-rail"><span class="rail-word">DECUBA<br />TECH / 01</span><span class="rail-year">ONLINE</span></aside><div class="page"><header class="site-header"><a href="/" class="mobile-brand"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><div class="issue"><i></i> Live field notes <span>/</span> Microsoft cloud + AI</div><nav><details><summary>AI</summary><div class="submenu"><a href="/category/microsoft-foundry">Microsoft Foundry</a><a href="/category/microsoft-copilot">Microsoft Copilot</a></div></details><details><summary>Power Platform</summary><div class="submenu"><a href="/category/power-automate">Power Automate</a><a href="/category/power-pages">Power Pages</a><a href="/category/power-apps">Power Apps</a><a href="/category/power-bi">Power BI</a><a href="/category/copilot-studio">Copilot Studio</a><a href="/category/ai-builder">AI Builder</a></div></details><details><summary>M365</summary><div class="submenu"><a href="/category/intune">Intune</a><a href="/category/m365">M365</a><a href="/category/teams">Teams</a><a href="/category/powerpoint">PowerPoint</a><a href="/category/excel">Excel</a><a href="/category/word">Word</a><a href="/category/outlook">Outlook</a></div></details><a href="/about">About</a></nav></header><main><slot /></main><footer><div class="footer-mark"><img src="/images/decuba-logo.png" alt="decuba.tech" /><span>Personal technology writing<br />with a point of view.</span></div><div class="footer-links"><a href="/about">About</a><a href="/">Index</a><small>Copyright © {new Date().getFullYear()} decuba.tech · Written by Lisandro de Cuba</small></div></footer></div></div></body></html>
<script is:inline>
document.querySelectorAll('nav details').forEach((current) => {
  current.addEventListener('toggle', () => {
    if (!current.open) return;
    document.querySelectorAll('nav details').forEach((other) => {
      if (other !== current) other.removeAttribute('open');
    });
  });
});
document.addEventListener('click', (event) => {
  if (event.target.closest('nav')) return;
  document.querySelectorAll('nav details[open]').forEach((menu) => menu.removeAttribute('open'));
});
const toggle = document.createElement('button');
toggle.className = 'theme-toggle';
toggle.type = 'button';
toggle.setAttribute('aria-label', 'Switch colour theme');
toggle.textContent = '☼';
document.querySelector('nav')?.append(toggle);
const savedTheme = localStorage.getItem('decuba-theme');
if (savedTheme === 'light') document.documentElement.dataset.theme = 'light';
const syncTheme = () => { const light = document.documentElement.dataset.theme === 'light'; toggle.textContent = light ? '☾' : '☼'; toggle.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode'); };
syncTheme();
toggle.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'light' ? '' : 'light'; document.documentElement.dataset.theme = next; localStorage.setItem('decuba-theme', next); syncTheme(); });
const nav = document.querySelector('nav');
if (nav) {
  nav.replaceChildren();
  const group = document.createElement('details');
  const summary = document.createElement('summary');
  summary.textContent = 'Techblog';
  const submenu = document.createElement('div');
  submenu.className = 'submenu';
  [['Microsoft Copilot','/category/microsoft-copilot'],['AI Builder','/category/ai-builder'],['Microsoft Foundry','/category/microsoft-foundry']].forEach(([label,href]) => { const link=document.createElement('a'); link.textContent=label; link.href=href; submenu.append(link); });
  group.append(summary, submenu);
  const about = document.createElement('a'); about.textContent='About'; about.href='/about';
  nav.append(group, about, toggle);
  const linkedin = document.createElement('a'); linkedin.className='social-link'; linkedin.textContent='LinkedIn'; linkedin.href='https://www.linkedin.com/in/lisandro-de-cuba-%E2%9C%A8-7ab88a9'; linkedin.target='_blank'; linkedin.rel='noreferrer';
  const github = document.createElement('a'); github.className='social-link'; github.textContent='GitHub'; github.href='https://github.com/ldecuba'; github.target='_blank'; github.rel='noreferrer';
  nav.append(linkedin, github);
}
</script>
<style is:global>
.social-link{border:1px solid var(--line);padding:.42rem .55rem;color:var(--muted);font:500 .62rem 'DM Mono',monospace;text-transform:none}.social-link:hover{border-color:var(--cyan);color:var(--cyan)}
.page{max-width:1320px;margin:0 auto;border-left:1px solid var(--line);border-right:1px solid var(--line)}
@media(max-width:760px){.page{max-width:none;border-left:0;border-right:0}}
</style>
<style is:global>
html[data-theme='light'] .signal-ticker{background:#f8fafc;color:#526174;border-color:#b9c7d6}html[data-theme='light'] .signal-ticker span{color:#1454a0}html[data-theme='light'] .signal-ticker b{color:#c62b79}html[data-theme='light'] .hero-aside strong{color:#1454a0}html[data-theme='light'] .signal-bars i{background:#1689a0}html[data-theme='light'] .signal-bars i:nth-child(4),html[data-theme='light'] .signal-bars i:nth-child(6){background:#c62b79}html[data-theme='light'] .section-label,html[data-theme='light'] .feature-label{color:#1454a0}html[data-theme='light'] .meta,html[data-theme='light'] .kicker{color:#1454a0}html[data-theme='light'] .feature-controls button{background:#b9c7d6}html[data-theme='light'] .feature-controls button.active{background:#c62b79}
html[data-theme='light'] .article-meta,html[data-theme='light'] .article-tags{color:#1454a0}html[data-theme='light'] .article-body h2{color:#111827}html[data-theme='light'] .feature-image{border-color:#1689a0}
</style>
<style is:global>
:root[data-theme='light']{color:#111827;background:#eef2f6;--ink:#111827;--muted:#526174;--line:#c4ceda;--panel:#f8fafc}html[data-theme='light'] body{background-color:#eef2f6;background-image:linear-gradient(#dce3eb 1px,transparent 1px),linear-gradient(90deg,#dce3eb 1px,transparent 1px)}html[data-theme='light'] .page,html[data-theme='light'] .site-header,html[data-theme='light'] footer{background:rgba(238,242,246,.94)}html[data-theme='light'] .side-rail{background:#e2e8f0}html[data-theme='light'] .rail-word,html[data-theme='light'] .rail-year{color:#1454a0}html[data-theme='light'] .mobile-brand img,html[data-theme='light'] .footer-mark img{filter:none}html[data-theme='light'] .submenu{background:#f8fafc;box-shadow:8px 8px 0 #cbd5e1}html[data-theme='light'] .submenu a:hover{color:#111827;background:#e6edf5}.theme-toggle{border:1px solid var(--lime);background:transparent;color:var(--lime);font:500 .62rem 'DM Mono',monospace;padding:.45rem .55rem;cursor:pointer}.theme-toggle:hover{background:var(--lime);color:#080b11}html[data-theme='light'] .theme-toggle{border-color:#1454a0;color:#1454a0}
</style>
<style is:global>
html[data-theme='light'] .site-header{background:rgba(238,242,246,.96);border-color:#c4ceda}html[data-theme='light'] .page{background:rgba(238,242,246,.82)}html[data-theme='light'] .side-rail{background:#dce5ef;border-color:#b9c7d6}html[data-theme='light'] .rail-word{color:#1454a0}html[data-theme='light'] .rail-year{color:#c62b79}html[data-theme='light'] .hero{border-color:#1689a0}html[data-theme='light'] .hero-aside,html[data-theme='light'] .feature-board{background:#f8fafc;border-color:#1689a0;color:#526174}html[data-theme='light'] .feature-board:after{color:#e1e8f0}html[data-theme='light'] .post,html[data-theme='light'] .posts{border-color:#c4ceda}html[data-theme='light'] .submenu{background:#f8fafc;border-color:#1689a0;box-shadow:8px 8px 0 #cbd5e1}html[data-theme='light'] .submenu a{color:#526174}html[data-theme='light'] .submenu a:hover{background:#e6edf5;color:#111827}html[data-theme='light'] .read{color:#1454a0;border-color:#1454a0}html[data-theme='light'] .read:hover{background:#1454a0;color:#fff}html[data-theme='light'] .article-body{color:#39485a}html[data-theme='light'] footer{background:#eef2f6;border-color:#c4ceda}html[data-theme='light'] .footer-mark img{filter:none}.theme-toggle{font-size:1.3rem;line-height:1;width:2rem;height:2rem;padding:0;border:0;color:var(--lime);background:transparent}.theme-toggle:hover{background:transparent;color:var(--pink)}html[data-theme='light'] .theme-toggle{color:#1454a0}
</style>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');
:root{font-family:'Manrope',sans-serif;color:#f4f7fb;background:#080b11;--ink:#f4f7fb;--muted:#9aa5b5;--cyan:#39e7ff;--pink:#ff4ca0;--lime:#c9ff4a;--line:#273140;--panel:#0d131d}*{box-sizing:border-box}body{margin:0;min-width:320px;background-color:#080b11;background-image:linear-gradient(#151d29 1px,transparent 1px),linear-gradient(90deg,#151d29 1px,transparent 1px);background-size:42px 42px}.site-shell{display:grid;grid-template-columns:86px 1fr;min-height:100vh}.side-rail{background:#0b1018;border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:1rem .75rem 1.2rem;position:sticky;top:0;height:100vh}.rail-word,.rail-year{font:500 .6rem 'DM Mono',monospace;letter-spacing:.1em;writing-mode:vertical-rl;transform:rotate(180deg);color:var(--cyan)}.rail-year{color:var(--pink)}.page{max-width:1500px;width:100%;background:rgba(8,11,17,.8)}.site-header{position:sticky;top:0;z-index:20;min-height:78px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:1.1rem clamp(1.25rem,4vw,4.5rem);gap:2rem;background:rgba(8,11,17,.94);backdrop-filter:blur(12px)}.mobile-brand{display:block}.mobile-brand img{width:155px;height:auto;filter:brightness(0) invert(1)}.issue,nav{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.05em}.issue{color:var(--muted)}.issue i{display:inline-block;width:7px;height:7px;background:var(--lime);margin-right:.5rem;box-shadow:0 0 12px var(--lime)}.issue span{color:var(--pink);padding:0 .5rem}nav{display:flex;gap:1.1rem;align-items:center;flex-wrap:wrap;justify-content:flex-end}a{color:inherit;text-decoration:none}nav a:hover,nav summary:hover,.footer-links a:hover{color:var(--cyan)}nav details{position:relative}nav summary{list-style:none;cursor:pointer}nav summary::-webkit-details-marker{display:none}nav summary:after{content:' +';color:var(--pink)}nav details[open] summary:after{content:' -'}nav .submenu{position:absolute;right:0;top:1.5rem;z-index:30;min-width:190px;padding:.55rem 0;background:#0d131d;border:1px solid var(--cyan);box-shadow:8px 8px 0 #05070b;text-transform:none;letter-spacing:0}.submenu a{display:block;padding:.55rem .8rem;color:var(--muted);font:500 .72rem 'DM Mono',monospace}.submenu a:hover{color:var(--ink);background:#172333}main{padding:clamp(3rem,7vw,7rem) clamp(1.25rem,7vw,8rem) 8rem}.hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.55fr);gap:5rem;align-items:end;border-bottom:1px solid var(--cyan);padding-bottom:4rem}.kicker,.meta{font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;color:var(--cyan)}.hero h1{font:800 clamp(3.2rem,6.4vw,6.5rem) 'Manrope',sans-serif;line-height:.9;letter-spacing:-.07em;margin:1.1rem 0 1.5rem;max-width:9ch}.hero h1 em{font-style:normal;color:var(--pink)}.hero p{font-size:1.12rem;line-height:1.6;max-width:33rem;color:var(--muted);margin:0}.hero-aside{border:1px solid var(--line);border-left:3px solid var(--pink);padding:1.2rem;color:var(--muted);font-size:.88rem;line-height:1.65;background:var(--panel)}.hero-aside strong{display:block;color:var(--lime);font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:.8rem}.section-label{font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;margin:3.5rem 0 1rem;color:var(--lime)}.posts{border-top:1px solid var(--line)}.post{display:grid;grid-template-columns:10rem minmax(0,1fr) 11rem;gap:2rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--line)}.post h2{font:800 clamp(1.65rem,3vw,3.2rem) 'Manrope',sans-serif;line-height:.98;letter-spacing:-.05em;margin:0;max-width:18ch}.post p{color:var(--muted);line-height:1.5;margin:.5rem 0 0}.read{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;color:var(--cyan);justify-self:end;border:1px solid var(--cyan);padding:.6rem .7rem;margin-top:.3rem}.read:hover{background:var(--cyan);color:#080b11}.article-meta{color:var(--pink);font:500 .7rem 'DM Mono',monospace}.article h1,article h1{font:800 clamp(2.8rem,5.6vw,5.7rem) 'Manrope',sans-serif;line-height:.93;letter-spacing:-.07em;max-width:11ch;margin:1rem 0 3rem}.article-body{font-size:1.08rem;line-height:1.8;max-width:680px;color:#c2cbd7}.article-body h2{font:800 2.4rem 'Manrope',sans-serif;color:var(--ink);letter-spacing:-.06em;margin-top:3rem}.article-body strong{color:var(--lime)}footer{border-top:1px solid var(--line);padding:1.4rem clamp(1.25rem,7vw,8rem) 2rem;display:flex;justify-content:space-between;gap:2rem;font-size:.8rem;color:var(--muted);background:#080b11}.footer-mark{display:flex;gap:1rem;align-items:flex-start}.footer-mark img{width:125px;height:auto;filter:brightness(0) invert(1)}.footer-links{display:flex;gap:1rem;align-items:flex-start;flex-wrap:wrap;justify-content:flex-end}.footer-links small{flex-basis:100%;text-align:right;font:400 .62rem 'DM Mono',monospace}.intro{max-width:800px}.intro h1{font:800 clamp(3.2rem,6.4vw,6.5rem) 'Manrope',sans-serif;line-height:.9;letter-spacing:-.07em;max-width:11ch}.intro p{font-size:1.12rem;line-height:1.6;color:var(--muted)}
@media(max-width:1000px){.issue{display:none}nav{gap:.75rem;font-size:.6rem}}@media(max-width:760px){.site-shell{display:block}.side-rail{display:none}.site-header{min-height:70px;padding:1rem 1.25rem}.mobile-brand img{width:145px}nav{gap:.8rem;font-size:.61rem}nav .submenu{position:fixed;right:1rem;top:4.5rem;max-height:70vh;overflow:auto}main{padding:3.5rem 1.25rem 5rem}.hero{display:block;padding-bottom:2.5rem}.hero h1{font-size:clamp(3.2rem,14vw,5.7rem)}.hero-aside{margin-top:2.5rem}.post{grid-template-columns:1fr;gap:.7rem;padding:1.25rem 0}.post h2{font-size:2.4rem}.read{justify-self:start;margin-top:.5rem}footer{display:block;padding:1.5rem 1.25rem 2rem}.footer-links{justify-content:flex-start;margin-top:2rem}.footer-links small{text-align:left}}
</style>
