---
import OpeningIntro from '../components/OpeningIntro.astro';
const { title = 'decuba.tech' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Personal notes on Microsoft cloud, AI and the work around it." /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>{title} | decuba.tech</title></head><body>{Astro.url.pathname === '/' && <OpeningIntro />}<div class="site-shell"><header class="site-header"><a href="/" class="brand" aria-label="decuba.tech home"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><nav aria-label="Main navigation"><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button><div class="site-menu" id="site-menu"><a href="/blog">Articles</a><a href="/about">About</a></div><button class="theme-toggle" type="button" aria-label="Switch colour theme"><span class="sun" aria-hidden="true">☼</span><span class="moon" aria-hidden="true">☾</span></button><a class="social-link" href="https://www.linkedin.com/in/lisandro-de-cuba-%E2%9C%A8-7ab88a9" target="_blank" rel="noreferrer" aria-label="LinkedIn"><span aria-hidden="true">in</span></a><a class="social-link" href="https://github.com/ldecuba" target="_blank" rel="noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.6-1.4-5.6-6a4.7 4.7 0 0 1 1.2-3.3c-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.4 1.2a11.7 11.7 0 0 1 6.2 0C17.8 5.9 18.8 6.2 18.8 6.2c.6 1.7.2 3 .1 3.3a4.7 4.7 0 0 1 1.2 3.3c0 4.6-2.9 5.7-5.6 6 .4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A12 12 0 0 0 12 .7Z"/></svg></a></nav></header><main><slot /></main><footer><div><img src="/images/decuba-logo.png" alt="decuba.tech" /><p>Independent notes on Microsoft cloud and AI.</p></div><div class="footer-links"><a href="/blog">Articles</a><a href="/about">About</a><small>© {new Date().getFullYear()} Lisandro de Cuba</small></div></footer></div></body></html>
<script is:inline>
const root=document.documentElement;const toggle=document.querySelector('.theme-toggle');const saved=localStorage.getItem('decuba-theme');if(saved==='dark'||(!saved&&matchMedia('(prefers-color-scheme: dark)').matches))root.dataset.theme='dark';toggle?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;localStorage.setItem('decuba-theme',next);toggle.setAttribute('aria-label',next==='dark'?'Switch to light mode':'Switch to dark mode')});
const menuToggle=document.querySelector('.menu-toggle');
const menu=document.querySelector('.site-menu');
const mobileMenu=matchMedia('(max-width:760px)');
const setMenuOpen=open=>{menuToggle?.setAttribute('aria-expanded',String(open));menuToggle?.setAttribute('aria-label',open?'Close navigation menu':'Open navigation menu')};
const closeMenu=()=>setMenuOpen(false);
menuToggle?.addEventListener('click',()=>setMenuOpen(menuToggle.getAttribute('aria-expanded')!=='true'));
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menuToggle?.getAttribute('aria-expanded')==='true'){closeMenu();menuToggle.focus()}});
document.addEventListener('click',event=>{if(event.target instanceof Node&&!menu?.contains(event.target)&&!menuToggle?.contains(event.target))closeMenu()});
menu?.addEventListener('click',event=>{if(event.target instanceof Element&&event.target.closest('a'))closeMenu()});
mobileMenu.addEventListener('change',closeMenu);
</script>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
:root{--ink:#111c33;--muted:#43516a;--accent:#155bd7;--accent-soft:#dce9ff;--line:#ccd6e4;--panel:#fff;--surface:#f7f9fc}:root[data-theme='dark']{--ink:#f4f7fc;--muted:#b5c0d2;--accent:#82b1ff;--accent-soft:#17305c;--line:#31405d}
:root{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#14213d;background:#f7f9fc;--ink:#14213d;--muted:#62708a;--accent:#2563eb;--accent-soft:#e8f0ff;--line:#dce3ed;--panel:#fff;--surface:#f0f4f9;--cyan:#2563eb;--pink:#2563eb;--lime:#2563eb;color-scheme:light}:root[data-theme='dark']{color:#edf3ff;background:#0b1020;--ink:#edf3ff;--muted:#9ba9c2;--accent:#76a9ff;--accent-soft:#14264a;--line:#273552;--panel:#111a2e;--surface:#0e1729;--cyan:#76a9ff;--pink:#76a9ff;--lime:#76a9ff;color-scheme:dark}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--surface);color:var(--ink)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.site-shell{min-height:100vh;display:flex;flex-direction:column}.site-header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1.25rem,5vw,4.5rem);background:color-mix(in srgb,var(--surface) 88%,transparent);border-bottom:1px solid var(--line);backdrop-filter:blur(18px);position:sticky;top:0;z-index:20}.brand img{display:block;width:148px;height:auto}.brand{display:flex;align-items:center}.site-header nav{display:flex;align-items:center;gap:.4rem}.site-menu>a{font-size:.88rem;font-weight:650;padding:.65rem .8rem;border-radius:.55rem}.site-menu>a:hover{background:var(--panel);color:var(--accent)}.social-link,.theme-toggle{display:grid;place-items:center;width:2.35rem;height:2.35rem;border:1px solid var(--line);border-radius:50%;background:var(--panel);color:var(--muted);cursor:pointer;margin-left:.25rem}.social-link:hover,.theme-toggle:hover{color:var(--accent);border-color:var(--accent)}.social-link span{font:700 .78rem Arial}.social-link svg{width:1rem;height:1rem;fill:currentColor}.theme-toggle{font-size:1.15rem}.theme-toggle .moon,:root[data-theme='dark'] .theme-toggle .sun{display:none}:root[data-theme='dark'] .theme-toggle .moon{display:block}.brand img,footer img{filter:none}:root[data-theme='dark'] .brand img,:root[data-theme='dark'] footer img{filter:brightness(0) invert(1)}main{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(3.5rem,7vw,7rem) 0 7rem;flex:1}.kicker,.meta,.article-meta{font:500 .72rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--accent)}.hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:clamp(2rem,6vw,6rem);align-items:end;padding-bottom:4.5rem}.hero h1,.intro h1{font-size:clamp(3.1rem,7.4vw,6.7rem);line-height:.96;letter-spacing:-.075em;margin:1.1rem 0 1.5rem;max-width:10ch}.hero h1 em{font-style:normal;color:var(--accent)}.hero p,.intro p{max-width:600px;font-size:clamp(1.05rem,1.6vw,1.25rem);line-height:1.7;color:var(--muted)}.hero-aside{padding:1.35rem;border-top:3px solid var(--accent);background:var(--panel);box-shadow:0 16px 50px rgba(31,48,82,.08);font-size:.9rem;line-height:1.6;color:var(--muted)}.hero-aside strong{display:block;color:var(--ink);font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.8rem}.section-label{font:600 .76rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:4rem 0 1rem}.posts{border-top:1px solid var(--line)}.post{display:grid;grid-template-columns:9rem minmax(0,1fr) 9rem;gap:2rem;padding:2rem 0;border-bottom:1px solid var(--line);align-items:start}.post h2{font-size:clamp(1.5rem,2.7vw,2.55rem);line-height:1.1;letter-spacing:-.045em;margin:0;max-width:22ch}.post p{color:var(--muted);line-height:1.6;margin:.7rem 0 0}.read{display:inline-flex;align-items:center;justify-content:center;justify-self:end;color:var(--accent);font-size:.78rem;font-weight:700;padding:.7rem .9rem;border:1px solid var(--line);border-radius:.55rem;background:var(--panel)}.read:hover{color:#fff;background:var(--accent);border-color:var(--accent)}.article-body{font-size:1.08rem;line-height:1.85;color:var(--muted)}.article-body h2,.article-body h3{color:var(--ink);letter-spacing:-.04em}.article-body strong{color:var(--ink)}footer{display:flex;justify-content:space-between;gap:2rem;padding:2.4rem max(1.25rem,calc((100vw - 1180px)/2));border-top:1px solid var(--line);background:var(--panel);color:var(--muted);font-size:.78rem}footer img{width:120px}footer p{margin:.8rem 0 0}.footer-links{display:flex;align-items:flex-start;gap:1rem;flex-wrap:wrap;justify-content:flex-end}.footer-links a:hover{color:var(--accent)}.footer-links small{flex-basis:100%;text-align:right}
@media(max-width:760px){.site-header{height:68px;padding:0 1rem}.brand img{width:125px}.site-header nav{gap:.1rem}.site-menu>a{font-size:.76rem;padding:.5rem}.social-link{display:none}.theme-toggle{width:2.1rem;height:2.1rem}main{width:min(100% - 2rem,1180px);padding:3.5rem 0 5rem}.hero{display:block;padding-bottom:2.8rem}.hero-aside{margin-top:2.5rem}.post{grid-template-columns:1fr;gap:.65rem;padding:1.5rem 0}.read{justify-self:start;margin-top:.5rem}footer{display:block;padding:2rem 1rem}.footer-links{justify-content:flex-start;margin-top:1.5rem}.footer-links small{text-align:left}}
</style>
<style is:global>
@media(max-width:760px){.site-menu{display:none}.site-header{padding:0 .85rem}.site-header .brand img{width:108px}.site-header nav{position:absolute;right:.85rem;gap:.25rem}.site-header .theme-toggle,.site-header .social-link{display:grid;width:2rem;height:2rem;margin-left:0;flex:0 0 2rem}.site-menu>a{padding:.45rem .4rem}}
</style>
<style is:global>
html,body{max-width:100vw;overflow-x:clip}.site-header{width:100%;max-width:100vw}
.home-sections .hero{grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr)}.home-sections .hero h1{font-size:clamp(3rem,5.6vw,5.35rem);max-width:9ch}.home-sections .hero-visual img{height:380px}@media(max-width:760px){.home-sections .hero{display:block}.home-sections .hero h1{font-size:clamp(2.8rem,12vw,4.2rem)}.site-header{gap:.5rem}.site-header .brand img{width:112px}.site-header nav{gap:.05rem;flex-wrap:nowrap}.site-menu>a{padding:.4rem .35rem;font-size:.7rem}.site-header .social-link{display:grid;width:1.9rem;height:1.9rem;margin-left:.1rem}.site-header .theme-toggle{width:1.9rem;height:1.9rem;margin-left:.1rem}.home-sections .hero-visual img{height:240px}}@media(max-width:370px){.site-header .brand img{width:98px}.site-menu>a{padding:.35rem .22rem;font-size:.65rem}.site-header .social-link,.site-header .theme-toggle{width:1.75rem;height:1.75rem}}
</style>

<style is:global>
.site-menu{display:flex;align-items:center;gap:.4rem}.menu-toggle{display:none;border:1px solid var(--line);border-radius:.55rem;background:var(--panel);color:var(--ink);font-size:.78rem;font-weight:650;cursor:pointer;width:44px;height:44px;place-items:center;padding:.5rem}.menu-toggle svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.menu-toggle:hover{border-color:var(--accent);color:var(--accent)}.menu-toggle:focus-visible,.site-menu a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media(max-width:760px){.menu-toggle{display:grid}.site-menu{display:none;position:absolute;top:calc(100% + 1rem);right:0;width:200px;padding:.5rem;border:1px solid var(--line);border-radius:.75rem;background:var(--panel);box-shadow:0 12px 30px rgba(27,46,83,.15)}.menu-toggle[aria-expanded='true']+.site-menu{display:flex;flex-direction:column;align-items:stretch}.site-header .site-menu>a{display:block;min-height:44px;padding:.8rem;font-size:.9rem}}
</style>