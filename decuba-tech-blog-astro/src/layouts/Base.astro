---
const { title = 'decuba.tech' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | decuba.tech</title>
    <meta name="description" content="Personal notes on Microsoft cloud, AI and the work around it." />
  </head>
  <body>
    <div class="site-shell"><aside class="side-rail"><a href="/" class="rail-brand"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><span class="rail-word">DECUBA<br />TECH / 01</span><span class="rail-year">ONLINE</span></aside><div class="page"><header class="site-header"><a href="/" class="mobile-brand"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><div class="issue"><i></i> Live field notes <span>/</span> Microsoft cloud + AI</div><nav><a href="/category/ai">AI</a><a href="/category/microsoft">Microsoft</a><a href="/about">About</a></nav></header><main><slot /></main><footer><div class="footer-mark"><img src="/images/decuba-logo.png" alt="decuba.tech" /><span>Personal technology writing<br />with a point of view.</span></div><div class="footer-links"><a href="/about">About</a><a href="/">Index</a><small>Copyright © {new Date().getFullYear()} decuba.tech · Written by Lisandro de Cuba</small></div></footer></div></div>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');
:root{font-family:'Manrope',sans-serif;color:#f4f7fb;background:#080b11;--ink:#f4f7fb;--muted:#9aa5b5;--cyan:#39e7ff;--pink:#ff4ca0;--lime:#c9ff4a;--line:#273140;--panel:#0d131d}*{box-sizing:border-box}body{margin:0;min-width:320px;background-color:#080b11;background-image:linear-gradient(#151d29 1px,transparent 1px),linear-gradient(90deg,#151d29 1px,transparent 1px);background-size:42px 42px}.site-shell{display:grid;grid-template-columns:86px 1fr;min-height:100vh}.side-rail{background:#0b1018;border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:1rem .75rem 1.2rem;position:sticky;top:0;height:100vh}.rail-brand img{width:52px;filter:brightness(0) invert(1)}.rail-word,.rail-year{font:500 .6rem 'DM Mono',monospace;letter-spacing:.1em;writing-mode:vertical-rl;transform:rotate(180deg);color:var(--cyan)}.rail-year{color:var(--pink)}.page{max-width:1500px;width:100%;background:rgba(8,11,17,.8)}.site-header{min-height:78px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:1.1rem clamp(1.25rem,4vw,4.5rem);gap:2rem;background:#080b11}.mobile-brand{display:none}.issue,nav{font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.issue{color:var(--muted)}.issue i{display:inline-block;width:7px;height:7px;background:var(--lime);margin-right:.5rem;box-shadow:0 0 12px var(--lime)}.issue span{color:var(--pink);padding:0 .5rem}nav{display:flex;gap:1.4rem}a{color:inherit;text-decoration:none}nav a:hover,.footer-links a:hover{color:var(--cyan)}main{padding:clamp(3rem,7vw,7rem) clamp(1.25rem,7vw,8rem) 8rem}.hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.55fr);gap:5rem;align-items:end;border-bottom:1px solid var(--cyan);padding-bottom:4rem}.kicker,.meta{font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;color:var(--cyan)}.hero h1{font:800 clamp(3.7rem,9vw,9rem) 'Manrope',sans-serif;line-height:.88;letter-spacing:-.08em;margin:1.1rem 0 1.5rem;max-width:8ch}.hero h1 em{font-style:normal;color:var(--pink)}.hero p{font-size:1.12rem;line-height:1.6;max-width:33rem;color:var(--muted);margin:0}.hero-aside{border:1px solid var(--line);border-left:3px solid var(--pink);padding:1.2rem;color:var(--muted);font-size:.88rem;line-height:1.65;background:var(--panel)}.hero-aside strong{display:block;color:var(--lime);font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:.8rem}.section-label{font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;margin:3.5rem 0 1rem;color:var(--lime)}.posts{border-top:1px solid var(--line)}.post{display:grid;grid-template-columns:10rem minmax(0,1fr) 11rem;gap:2rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--line)}.post h2{font:800 clamp(1.65rem,3vw,3.2rem) 'Manrope',sans-serif;line-height:.98;letter-spacing:-.05em;margin:0;max-width:18ch}.post p{color:var(--muted);line-height:1.5;margin:.5rem 0 0}.read{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;color:var(--cyan);justify-self:end;border:1px solid var(--cyan);padding:.6rem .7rem;margin-top:.3rem}.read:hover{background:var(--cyan);color:#080b11}.article-meta{color:var(--pink);font:500 .7rem 'DM Mono',monospace}.article h1,article h1{font:800 clamp(3.3rem,8vw,8rem) 'Manrope',sans-serif;line-height:.9;letter-spacing:-.08em;max-width:9ch;margin:1rem 0 3rem}.article-body{font-size:1.08rem;line-height:1.8;max-width:680px;color:#c2cbd7}.article-body h2{font:800 2.4rem 'Manrope',sans-serif;color:var(--ink);letter-spacing:-.06em;margin-top:3rem}.article-body strong{color:var(--lime)}footer{border-top:1px solid var(--line);padding:1.4rem clamp(1.25rem,7vw,8rem) 2rem;display:flex;justify-content:space-between;gap:2rem;font-size:.8rem;color:var(--muted);background:#080b11}.footer-mark{display:flex;gap:1rem;align-items:flex-start}.footer-mark img{width:125px;height:auto;filter:brightness(0) invert(1)}.footer-links{display:flex;gap:1rem;align-items:flex-start;flex-wrap:wrap;justify-content:flex-end}.footer-links small{flex-basis:100%;text-align:right;font:400 .62rem 'DM Mono',monospace}.intro{max-width:800px}.intro h1{font:800 clamp(3.7rem,9vw,9rem) 'Manrope',sans-serif;line-height:.88;letter-spacing:-.08em;max-width:9ch}.intro p{font-size:1.12rem;line-height:1.6;color:var(--muted)}
@media(max-width:760px){.site-shell{display:block}.side-rail{display:none}.site-header{min-height:70px;padding:1rem 1.25rem}.mobile-brand{display:block}.mobile-brand img{width:120px;height:auto;filter:brightness(0) invert(1)}.issue{display:none}nav{gap:.8rem;font-size:.61rem}main{padding:3.5rem 1.25rem 5rem}.hero{display:block;padding-bottom:2.5rem}.hero h1{font-size:clamp(3.9rem,18vw,8rem)}.hero-aside{margin-top:2.5rem}.post{grid-template-columns:1fr;gap:.7rem;padding:1.25rem 0}.post h2{font-size:2.4rem}.read{justify-self:start;margin-top:.5rem}footer{display:block;padding:1.5rem 1.25rem 2rem}.footer-links{justify-content:flex-start;margin-top:2rem}.footer-links small{text-align:left}}
</style>
