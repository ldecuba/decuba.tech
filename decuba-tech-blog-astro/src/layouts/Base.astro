---
const { title = 'decuba.tech' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title} | decuba.tech</title><meta name="description" content="Notes on Microsoft cloud, AI and the work around it." /></head><body>
<header class="site-header"><a class="brand" href="/"><img src="/images/decuba-logo.png" alt="decuba.tech" /></a><nav><a href="/">Home</a><a href="/category/ai">AI</a><a href="/category/microsoft">Microsoft</a><a href="/about">About</a><button id="theme" aria-label="Toggle colour mode">◐</button></nav></header>
<main><slot /></main><footer><div><img src="/images/decuba-logo.png" alt="decuba.tech" /><p>Personal notes on cloud, AI, and the Microsoft stack.</p></div><div><a href="/about">About me</a><a href="/">All posts</a><small>Copyright © {new Date().getFullYear()} decuba.tech. All rights reserved.</small></div></footer>
<script is:inline>const b=document.body;const saved=localStorage.getItem('theme');if(saved)b.dataset.theme=saved;document.querySelector('#theme')?.addEventListener('click',()=>{const t=b.dataset.theme==='light'?'dark':'light';b.dataset.theme=t;localStorage.setItem('theme',t)});</script>
</body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e9eef7;background:#080c16;--muted:#91a1ba;--line:#263249;--accent:#39bdf4;--card:#101827}*{box-sizing:border-box}body{margin:0;min-width:320px}body[data-theme=light]{color:#142033;background:#f4f7fb;--muted:#53647b;--line:#d5deea;--card:#fff}.site-header{display:flex;align-items:center;justify-content:space-between;max-width:1180px;margin:auto;padding:1.3rem 1.25rem;border-bottom:1px solid var(--line)}.brand img{width:170px;height:auto;display:block}nav{display:flex;gap:1.3rem;align-items:center}a{color:inherit;text-decoration:none}nav a:hover,footer a:hover{color:var(--accent)}button{border:1px solid var(--line);background:var(--card);color:inherit;border-radius:50%;width:2.3rem;height:2.3rem;cursor:pointer;font-size:1.1rem}main{max-width:1180px;margin:auto;padding:4.5rem 1.25rem 7rem}.intro{max-width:800px;margin-bottom:4rem}.kicker{font:700 .78rem ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:#34d399}.intro h1{font-size:clamp(3rem,8vw,7.5rem);line-height:.9;letter-spacing:-.06em;margin:1rem 0 1.4rem;max-width:9ch}.intro p{font-size:1.25rem;line-height:1.6;color:var(--muted);max-width:600px}.posts{display:grid;grid-template-columns:repeat(12,1fr);gap:1.1rem}.post{grid-column:span 7;background:var(--card);border:1px solid var(--line);padding:1.5rem;min-height:14rem;display:flex;flex-direction:column;justify-content:space-between}.post:nth-child(2),.post:nth-child(3){grid-column:span 5}.post:nth-child(3){grid-column:span 4}.post h2{font-size:clamp(1.4rem,3vw,2.5rem);line-height:1.05;margin:.8rem 0}.post p{color:var(--muted);line-height:1.55}.meta{color:var(--accent);font:700 .75rem ui-monospace,monospace;text-transform:uppercase}.read{color:var(--accent);font-weight:700}article{max-width:820px;margin:auto}article h1{font-size:clamp(2.8rem,7vw,6rem);line-height:.94;letter-spacing:-.05em;max-width:12ch;margin:1rem 0 1.5rem}.article-meta{color:var(--accent);font:700 .8rem ui-monospace,monospace}.article-body{font-size:1.1rem;line-height:1.8;color:var(--muted)}.article-body h2{color:inherit;margin-top:2.5rem}.article-body strong{color:inherit}footer{border-top:1px solid var(--line);max-width:1180px;margin:auto;padding:2.2rem 1.25rem 3rem;display:flex;justify-content:space-between;gap:2rem;color:var(--muted)}footer img{width:150px}footer div:last-child{display:flex;gap:1.2rem;align-items:flex-end;flex-wrap:wrap}footer small{flex-basis:100%}@media(max-width:700px){.site-header,footer{align-items:flex-start;gap:1.5rem;flex-direction:column}nav{width:100%;justify-content:space-between}.posts{display:block}.post{margin-bottom:1rem}.intro h1{font-size:clamp(3.4rem,17vw,6rem)}main{padding-top:3rem}}
</style>
