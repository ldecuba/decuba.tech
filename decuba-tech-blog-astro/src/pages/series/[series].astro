---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import catalog from '../../data/series.json';
import { buildSeries, episodeNumber } from '../../lib/series.js';
export async function getStaticPaths() {
  return buildSeries(await getCollection('posts'), catalog).map(series => ({ params: { series: series.id }, props: { series } }));
}
const { series } = Astro.props;
---
<Base title={series.title} description={series.description}>
  <a class="series-back" href="/series/">All series</a>
  <header class="series-heading"><span class="kicker">Article series · {series.posts.length} episodes</span><h1>{series.title}</h1><p>{series.description}</p></header>
  <ol class="episode-list" aria-label="Episodes in reading order">
    {series.posts.map((post, index) => <li value={episodeNumber(post, index)}><article><span class="meta">Episode {episodeNumber(post, index)}</span><h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="read" href={`/posts/${post.id}/`} aria-label={`Read episode ${episodeNumber(post, index)}: ${post.data.title}`}>Read episode</a></article></li>)}
  </ol>
</Base>
<style>
.series-back{display:inline-block;margin-bottom:2rem;font-size:.85rem;color:var(--accent);text-decoration:underline;text-underline-offset:4px}.series-heading{max-width:900px;margin-bottom:3rem}.series-heading h1{font-size:clamp(2.2rem,4.7vw,4rem);line-height:1.15;letter-spacing:-.05em;margin:1rem 0 1.5rem;overflow-wrap:anywhere}.series-heading p{max-width:760px;font-size:1.1rem;line-height:1.8;color:var(--muted)}.episode-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line);max-width:920px}.episode-list li{padding:2rem 0;border-bottom:1px solid var(--line)}.episode-list h2{font-size:clamp(1.4rem,3vw,2rem);line-height:1.25;letter-spacing:-.03em;margin:.7rem 0}.episode-list h2 a:hover{color:var(--accent)}.episode-list p{color:var(--muted);line-height:1.7;max-width:700px}.episode-list .read{margin-top:.5rem}a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
</style>
