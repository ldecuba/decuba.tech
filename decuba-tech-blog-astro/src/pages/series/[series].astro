---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import catalog from '../../data/series.json';
import { buildSeries, episodeNumber } from '../../lib/series.js';
import { categoryIcons } from '../../lib/category-icons';
export async function getStaticPaths() {
  return buildSeries(await getCollection('posts'), catalog).map(series => ({ params: { series: series.id }, props: { series } }));
}
const { series } = Astro.props;
---
<Base title={series.title} description={series.description}>
  <a class="series-back" href="/series/">All series</a>
  <header class="series-heading"><span class="kicker">Article series · {series.posts.length} episodes</span><h1>{series.title}</h1><p>{series.description}</p></header>
  <ol class="episode-grid" aria-label="Episodes in reading order">
    {series.posts.map((post, index) => { const primaryCategory=post.data.primaryCategory || post.data.category; const categoryIcon=categoryIcons[primaryCategory]; const number=episodeNumber(post,index); return <li class="blog-card" value={number}>
      <a class="card-image" href={`/posts/${post.id}/`} aria-label={`Read episode ${number}: ${post.data.title}`}><img class="card-art" src={post.data.featureImage} alt={post.data.featureImageAlt || ''} />{categoryIcon && <span class="category-icon" aria-hidden="true"><img src={categoryIcon} alt="" /></span>}</a>
      <div class="blog-card-body"><div class="card-top"><div class="meta">Episode {number} · {primaryCategory}</div><span class={`level level-${post.data.level.toLowerCase()}`}>{post.data.level}</span></div><h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="card-footer"><span>{post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</span><a href={`/posts/${post.id}/`} aria-label={`Read episode ${number}: ${post.data.title}`}>Read episode →</a></div></div>
    </li>; })}
  </ol>
</Base>
<style is:global>
.series-back{display:inline-block;margin-bottom:2rem;font-size:.85rem;color:var(--accent);text-decoration:underline;text-underline-offset:4px}.series-heading{max-width:900px;margin-bottom:3rem}.series-heading h1{font-size:clamp(2.2rem,4.7vw,4rem);line-height:1.15;letter-spacing:-.05em;margin:1rem 0 1.5rem;overflow-wrap:anywhere}.series-heading p{max-width:760px;font-size:1.1rem;line-height:1.8;color:var(--muted)}
.episode-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;margin:0;padding:0;list-style:none;counter-reset:episode}.episode-grid>.blog-card{min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:.9rem;background:var(--panel);transition:transform .2s,box-shadow .2s}.episode-grid>.blog-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(27,46,83,.11)}.card-image{position:relative;display:block;overflow:hidden}.card-art{display:block;width:100%;height:180px;object-fit:cover;transition:transform .3s}.blog-card:hover .card-art{transform:scale(1.025)}.category-icon{position:absolute;top:.8rem;right:.8rem;display:grid;width:46px;height:46px;place-items:center;border:1px solid rgba(255,255,255,.22);border-radius:.7rem;background:rgba(8,13,25,.72);box-shadow:0 8px 24px rgba(0,0,0,.24);backdrop-filter:blur(8px)}.category-icon img{display:block;width:27px;height:27px;object-fit:contain}.category-icon img[src$="/github.svg"],.category-icon img[src$="/github-copilot.svg"]{filter:brightness(0) invert(1)}.blog-card-body{min-height:290px;padding:1.25rem;display:flex;flex-direction:column}.card-top,.card-footer{display:flex;justify-content:space-between;gap:1rem;align-items:center}.card-top .meta{min-width:0;overflow-wrap:anywhere}.level{display:inline-block;flex:0 0 auto;color:var(--accent);font:500 .62rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.blog-card h2{font-size:1.4rem;line-height:1.18;letter-spacing:-.04em;margin:1rem 0 .6rem;overflow-wrap:anywhere}.blog-card h2 a:hover{color:var(--accent)}.blog-card p{color:var(--muted);line-height:1.6;margin:0 0 1.4rem}.card-footer{margin-top:auto;padding-top:1rem;border-top:1px solid var(--line);font-size:.72rem;color:var(--muted)}.card-footer a{color:var(--accent);font-weight:700;white-space:nowrap}.episode-grid a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(max-width:850px){.episode-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.episode-grid{grid-template-columns:1fr}.card-art{height:200px}}
</style>
