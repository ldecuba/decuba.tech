---
import Base from '../../layouts/Base.astro';
const categories={ai:'AI','microsoft-copilot':'Microsoft Copilot','copilot-studio':'Copilot Studio','microsoft-foundry':'Microsoft Foundry','azure-ai':'Azure AI','azure-openai':'Azure OpenAI','ai-builder':'AI Builder','github-copilot':'GitHub Copilot','power-platform':'Power Platform','power-apps':'Power Apps','power-automate':'Power Automate','power-bi':'Power BI','power-pages':'Power Pages',dataverse:'Dataverse','power-fx':'Power Fx','microsoft-365':'Microsoft 365',teams:'Teams',sharepoint:'SharePoint',onedrive:'OneDrive',outlook:'Outlook',exchange:'Exchange',excel:'Excel',word:'Word',powerpoint:'PowerPoint',loop:'Loop',planner:'Planner',lists:'Lists',forms:'Forms',viva:'Viva',intune:'Intune',azure:'Azure','microsoft-fabric':'Microsoft Fabric','azure-devops':'Azure DevOps',github:'GitHub','microsoft-graph':'Microsoft Graph','microsoft-entra':'Microsoft Entra','microsoft-security':'Microsoft Security',windows:'Windows'};
export function getStaticPaths(){const channels=['ai','microsoft-copilot','copilot-studio','microsoft-foundry','azure-ai','azure-openai','ai-builder','github-copilot','power-platform','power-apps','power-automate','power-bi','power-pages','dataverse','power-fx','microsoft-365','teams','sharepoint','onedrive','outlook','exchange','excel','word','powerpoint','loop','planner','lists','forms','viva','intune','azure','microsoft-fabric','azure-devops','github','microsoft-graph','microsoft-entra','microsoft-security','windows'];return channels.map(category=>({params:{category}}));}
const {category}=Astro.params;const label=categories[category]||'Notes';
---
<Base title={label}><section class="intro"><span class="kicker">Topic channel</span><h1>{label}<br />/ signal.</h1><p>Notes, experiments and practical takes from the Microsoft technology stack.</p></section><article class="post"><div class="meta">{label}</div><div><h2>The archive is warming up.</h2><p>New notes in this channel will appear here as the site grows.</p></div><a class="read" href="/">Back to index</a></article></Base>
