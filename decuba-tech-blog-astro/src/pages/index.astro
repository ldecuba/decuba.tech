---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const now = new Date();
const posts = (await getCollection('posts', ({ data }) => data.published && data.date <= now)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6).map(post=>({category:post.data.category,date:post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}),title:post.data.title,dek:post.data.description,slug:post.id}));
---
<Base><div class="home-sections"><section class="hero"><div class="hero-copy"><span class="kicker">Independent technology journal</span><h1>Microsoft <span class="hero-mark">AI</span> <em>and me.</em></h1><p class="personal-line">A personal tech blog.</p><a class="hero-link" href="/blog">Browse all articles <span>→</span></a></div><aside class="hero-visual"><img src="/images/ai-workspace-hero.png" alt="Professional using AI data tools at a contemporary workspace" /><div class="visual-footer"><div class="note-meter" aria-label="Published notes meter"><svg viewBox="0 0 44 44" aria-hidden="true"><circle class="meter-track" cx="22" cy="22" r="18"></circle><circle class="meter-value" cx="22" cy="22" r="18"></circle></svg><strong id="signal-count">00</strong></div><div class="note-copy"><strong>Published notes</strong><span id="signal-title">No posts published yet.</span></div></div></aside></section><section class="feature-board"><div class="feature-label"><span>Editor’s pick</span><span id="feature-count">00 / 00</span></div><div class="feature-content"><span class="meta" id="feature-category">READY FOR NOTES</span><h2 id="feature-title">No posts published yet.</h2><p id="feature-dek">Your next note will appear here once you publish it.</p><a class="read" id="feature-link" href="/admin">Write a note →</a></div><div class="feature-controls"></div></section><div class="section-label">Latest articles</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read article →</a></article>)}</section></div></Base>
<script define:vars={{ posts }}>
const notes = posts.map(post=>({...post,category:`${post.category.toUpperCase()} / FIELD NOTE`}));
const signalTitle = document.querySelector('#signal-title');
const signalCount = document.querySelector('#signal-count');
if (signalCount) signalCount.textContent = String(notes.length).padStart(2, '0');
const meter=document.querySelector('.meter-value');if(meter)meter.style.strokeDashoffset=String(113-(Math.min(notes.length,12)/12)*113);
if (signalTitle) {
  let signalIndex = 0;
  if (notes.length > 1) setInterval(() => {
    signalIndex = (signalIndex + 1) % notes.length;
    signalTitle.textContent = notes[signalIndex].title;
  }, 4200);
}
const controls=document.querySelector('.feature-controls');if(controls)controls.replaceChildren(...notes.map((note,index)=>{const button=document.createElement('button');button.type='button';button.dataset.slide=String(index);button.ariaLabel=`Show note ${index+1}`;if(index===0)button.className='active';return button}));
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; if(!note)return; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; const link=document.querySelector('#feature-link'); link.setAttribute('href', `/posts/${note.slug}`); link.textContent='Open note →'; document.querySelector('#feature-count').textContent=`${String(index+1).padStart(2,'0')} / ${String(notes.length).padStart(2,'0')}`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
if (notes.length) show(0);
if (notes.length > 1) { let autoIndex=0; setInterval(() => { autoIndex=(autoIndex+1)%notes.length; show(autoIndex); }, 7000); }
if (!notes.length) document.querySelector('.feature-controls')?.setAttribute('hidden','');
</script>
<style>
.hero-link{display:inline-flex;gap:.6rem;align-items:center;margin-top:1.8rem;color:var(--accent);font-size:.9rem;font-weight:700}.hero-link span{transition:transform .2s}.hero-link:hover span{transform:translateX(4px)}.hero-visual{position:relative;overflow:hidden;border-radius:1rem;background:var(--panel);box-shadow:0 24px 70px rgba(25,45,85,.14)}.hero-visual img{width:100%;height:300px;display:block;object-fit:cover}.hero-visual div{display:flex;flex-direction:column;gap:.4rem;padding:1.1rem 1.25rem}.hero-visual strong{font-size:.8rem}.hero-visual div>span{font-size:.78rem;line-height:1.5;color:var(--muted)}.feature-board{position:relative;min-height:330px;margin-top:1rem;padding:clamp(1.5rem,4vw,3rem);background:var(--ink);color:var(--surface);border-radius:1.1rem;overflow:hidden}.feature-board:after{content:'';position:absolute;width:280px;height:280px;right:-80px;top:-100px;border:70px solid color-mix(in srgb,var(--accent) 35%,transparent);border-radius:50%}.feature-label,.feature-content,.feature-controls{position:relative;z-index:1}.feature-label{display:flex;justify-content:space-between;color:#a9c7ff;font:500 .7rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.feature-content{max-width:720px;margin-top:3.2rem}.feature-content h2{font-size:clamp(2rem,4vw,4rem);line-height:1;letter-spacing:-.055em;margin:.7rem 0}.feature-content p{color:#b9c4d8;line-height:1.6;margin:.8rem 0 1.4rem}.feature-content .read{justify-self:start;border-color:#52617b;background:transparent;color:#fff}.feature-content .read:hover{background:var(--accent);border-color:var(--accent)}.feature-controls{position:absolute;right:2rem;bottom:2rem;display:flex;gap:.45rem}.feature-controls button{width:32px;height:5px;border:0;border-radius:1rem;background:#536078;padding:0;cursor:pointer}.feature-controls button.active{background:#fff}
</style>
<style is:global>
.hero h1 .hero-mark{color:var(--accent)}
@media(max-width:760px){.hero-visual{margin-top:2.5rem}.hero-visual img{height:220px}.feature-board{min-height:380px}.feature-controls{left:1.5rem;right:auto}.feature-board:after{opacity:.5}}
</style>
<style>
.personal-line{margin:.15rem 0 .55rem!important;color:var(--ink)!important;font-size:1rem!important;font-weight:750}.hero-visual img{height:340px}.visual-footer{display:grid!important;grid-template-columns:64px 1fr;align-items:center;gap:1rem!important;padding:1rem 1.2rem!important}.note-meter{position:relative;width:58px;height:58px;padding:0!important;display:grid!important;place-items:center}.note-meter svg{position:absolute;inset:0;width:58px;height:58px;transform:rotate(-90deg)}.note-meter circle{fill:none;stroke-width:4}.meter-track{stroke:var(--line)}.meter-value{stroke:var(--accent);stroke-linecap:round;stroke-dasharray:113;stroke-dashoffset:113;transition:stroke-dashoffset .8s ease}.note-meter strong{position:relative;color:var(--ink);font-size:.8rem}.note-copy{padding:0!important}.note-copy strong{color:var(--ink);font-size:.75rem;text-transform:uppercase;letter-spacing:.06em}.note-copy span{color:var(--muted);font-size:.78rem;line-height:1.45}.site-intro{display:grid;grid-template-columns:220px minmax(0,720px);gap:clamp(2rem,6vw,6rem);align-items:start;padding:2.4rem 0 3.2rem;border-top:1px solid var(--line)}.site-intro span{color:var(--accent);font:500 .72rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.site-intro p{margin:0;color:var(--ink);font-size:clamp(1.25rem,2.2vw,1.8rem);font-weight:600;line-height:1.45;letter-spacing:-.025em}@media(max-width:760px){.site-intro{grid-template-columns:1fr;gap:.8rem}.hero-visual img{height:240px}}
</style>
