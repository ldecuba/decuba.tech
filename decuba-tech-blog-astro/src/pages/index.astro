---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6).map(post=>({category:post.data.category,date:post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}),title:post.data.title,dek:post.data.description,slug:post.id}));
---
<Base><div class="signal-ticker" aria-label="Live topics"><div><span>NOW READING</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span><b>PERSONAL SYSTEMS</b><span>FIELD NOTES</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span></div></div><section class="hero"><div><span class="kicker">Personal field notes · decuba.tech</span><h1>Cloud, code &amp; the <em>bits between.</em></h1><p>I'm Lisandro. I write about Microsoft cloud technology, AI, and the small decisions that product announcements tend to leave out.</p></div><aside class="hero-aside"><strong>Current posts / <span id="signal-count">00</span></strong><div class="signal-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span id="signal-title">No posts published yet.</span></aside></section><section class="feature-board"><div class="feature-label"><span>FEATURED NOTE</span><span id="feature-count">00 / 00</span></div><div class="feature-content"><span class="meta" id="feature-category">READY FOR NOTES</span><h2 id="feature-title">No posts published yet.</h2><p id="feature-dek">Your next note will appear here once you publish it.</p><a class="read" id="feature-link" href="/admin">Write a note →</a></div><div class="feature-controls"></div></section><div class="section-label">Recent dispatches / 00</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read the note →</a></article>)}</section></Base>
<script define:vars={{ posts }}>
const notes = posts.map(post=>({...post,category:`${post.category.toUpperCase()} / FIELD NOTE`}));
const signalTitle = document.querySelector('#signal-title');
const signalCount = document.querySelector('#signal-count');
if (signalCount) signalCount.textContent = String(notes.length).padStart(2, '0');
if (signalTitle) {
  let signalIndex = 0;
  if (notes.length > 1) setInterval(() => {
    signalIndex = (signalIndex + 1) % notes.length;
    signalTitle.textContent = notes[signalIndex].title;
  }, 4200);
}
const controls=document.querySelector('.feature-controls');if(controls)controls.replaceChildren(...notes.map((note,index)=>{const button=document.createElement('button');button.type='button';button.dataset.slide=String(index);button.ariaLabel=`Show note ${index+1}`;if(index===0)button.className='active';return button}));
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; if(!note)return; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; document.querySelector('#feature-link').setAttribute('href', `/posts/${note.slug}`); document.querySelector('#feature-count').textContent=`${String(index+1).padStart(2,'0')} / ${String(notes.length).padStart(2,'0')}`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
if (notes.length) show(0);
if (notes.length > 1) { let autoIndex=0; setInterval(() => { autoIndex=(autoIndex+1)%notes.length; show(autoIndex); }, 7000); }
if (!notes.length) { document.querySelector('.feature-controls')?.setAttribute('hidden',''); document.querySelector('.signal-bars')?.setAttribute('hidden',''); }
document.querySelector('.hero h1').innerHTML='Microsoft <span class="hero-mark">AI,</span> <em>explored</em>';
document.querySelector('.hero p').textContent='A personal tech blog.';
</script>
<style>
.signal-ticker{overflow:hidden;border:1px solid var(--line);background:#101722;color:var(--muted);font:500 .65rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:2.5rem}.signal-ticker div{display:flex;width:max-content;gap:2rem;padding:.7rem 1rem;animation:drift 28s linear infinite}.signal-ticker span{color:var(--cyan)}.signal-ticker b{color:var(--pink);font-weight:500}@keyframes drift{to{transform:translateX(-35%)}}.signal-bars{height:54px;display:flex;align-items:end;gap:5px;margin:1rem 0}.signal-bars i{display:block;width:8px;background:var(--cyan);height:20%;animation:pulse 1.8s ease-in-out infinite alternate}.signal-bars i:nth-child(2){height:60%;animation-delay:.2s}.signal-bars i:nth-child(3){height:35%;animation-delay:.4s}.signal-bars i:nth-child(4){height:90%;animation-delay:.1s}.signal-bars i:nth-child(5){height:48%;animation-delay:.5s}.signal-bars i:nth-child(6){height:75%;animation-delay:.3s}.signal-bars i:nth-child(7){height:30%;animation-delay:.7s}.signal-bars i:nth-child(8){height:66%;animation-delay:.6s}@keyframes pulse{to{height:100%;background:var(--pink)}}
.feature-board{position:relative;display:block;max-width:100%;min-height:300px;margin:3.5rem 0 0;padding:1.5rem;background:var(--panel);border:1px solid var(--cyan);overflow:hidden}.feature-label,.feature-content,.feature-controls{position:relative;z-index:1}.feature-label{display:flex;justify-content:space-between;color:var(--lime);font:500 .67rem 'DM Mono',monospace;letter-spacing:.1em}.feature-content{max-width:700px;margin-top:3rem}.feature-content h2{font:800 clamp(2rem,4vw,4rem) 'Manrope',sans-serif;line-height:.95;letter-spacing:-.06em;margin:.7rem 0}.feature-content p{color:var(--muted);margin:.6rem 0 1.2rem}.feature-controls{position:absolute;right:1.5rem;bottom:1.5rem;display:flex;gap:.5rem}.feature-controls button{width:28px;height:4px;border:0;background:var(--line);padding:0;cursor:pointer}.feature-controls button.active{background:var(--pink)}
</style>
<style is:global>
.hero h1 .hero-mark{color:var(--cyan)}
@media(max-width:760px){.social-link{font-size:.55rem;padding:.35rem .42rem}}
</style>
