---
import Base from '../layouts/Base.astro';
const products=[['AZ','Azure'],['CP','Copilot'],['M365','Microsoft 365'],['BI','Power BI'],['PA','Power Apps'],['T','Teams'],['FO','Foundry'],['DV','Dataverse'],['AU','Power Automate'],['FA','Fabric'],['PP','Power Pages'],['XL','Excel']];
const posts=[{category:'AI',date:'12 Sep 2026',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'Microsoft',date:'08 Sep 2026',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'Cloud',date:'02 Sep 2026',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
---
<Base><div class="signal-ticker" aria-label="Live topics"><div><span>NOW READING</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span><b>PERSONAL SYSTEMS</b><span>FIELD NOTES</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span></div></div><section class="hero cinematic-hero"><div class="cinematic-stage"><div class="stage-grid"></div><div class="stage-brand">DECUBA<span>.TECH</span></div><div class="stage-title">DECUBA<span>.TECH</span></div><div class="brand-stream">{products.map(([mark,name],index)=><span class={`brand-item item-${index}`}><b>{mark}</b>{name}</span>)}</div><div class="stage-footer"><span>MICROSOFT CLOUD / AI / FIELD NOTES</span><span>SCROLL TO ENTER</span></div></div></section><section class="feature-board"><div class="feature-label"><span>FEATURED NOTE</span><span id="feature-count">01 / 03</span></div><div class="feature-content"><span class="meta" id="feature-category">AI / FIELD NOTE</span><h2 id="feature-title">The useful part of AI is usually the awkward bit</h2><p id="feature-dek">A field note on what happens after the demo ends.</p><a class="read" id="feature-link" href="/posts/the-useful-part-of-ai-is-usually-the-awkward-bit">Open note →</a></div><div class="feature-controls"><button type="button" data-slide="0" aria-label="Show note 1" class="active"></button><button type="button" data-slide="1" aria-label="Show note 2"></button><button type="button" data-slide="2" aria-label="Show note 3"></button></div></section><div class="section-label">Recent dispatches / 03</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read the note →</a></article>)}</section></Base>
<script>
const notes = [{category:'AI / FIELD NOTE',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'MICROSOFT / FIELD NOTE',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'CLOUD / FIELD NOTE',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; document.querySelector('#feature-link').setAttribute('href', `/posts/${note.slug}`); document.querySelector('#feature-count').textContent=`0${index+1} / 03`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
</script>
<style>
.cinematic-hero{display:block;padding:0;border:0}.cinematic-stage{height:min(78vh,820px);min-height:560px;max-width:1120px;margin:0 auto;position:relative;overflow:hidden;background:rgba(7,10,16,.55);border:1px solid var(--line)}.stage-grid{position:absolute;inset:0;background-image:linear-gradient(#17212e 1px,transparent 1px),linear-gradient(90deg,#17212e 1px,transparent 1px);background-size:52px 52px}.stage-brand{position:absolute;top:1.6rem;left:1.8rem;color:#f4f7fb;font:800 1.15rem 'Manrope',sans-serif;letter-spacing:-.06em}.stage-brand span,.stage-title span{color:var(--cyan)}.stage-title{position:absolute;z-index:2;inset:40% 0 auto;text-align:center;color:rgba(244,247,251,.12);font:800 clamp(4rem,11vw,10rem) 'Manrope',sans-serif;letter-spacing:-.11em;transform:translateY(-50%)}.brand-stream{position:absolute;inset:0;perspective:900px}.brand-item{position:absolute;left:50%;top:50%;display:flex;align-items:center;gap:.7rem;white-space:nowrap;color:rgba(244,247,251,.68);font:800 clamp(2rem,5vw,5rem) 'Manrope',sans-serif;letter-spacing:-.08em;opacity:0;transform:translate(-50%,-50%) scale(.18) rotate(-5deg);animation:brandCredits 19s linear infinite}.brand-item b{display:grid;place-items:center;width:clamp(2.4rem,5vw,5rem);height:clamp(2.4rem,5vw,5rem);border:2px solid currentColor;border-radius:50%;font:500 clamp(.55rem,1vw,1rem) 'DM Mono',monospace;letter-spacing:0}.item-1{animation-delay:1.6s;color:rgba(57,231,255,.72)}.item-2{animation-delay:3.2s;color:rgba(255,76,160,.68)}.item-3{animation-delay:4.8s}.item-4{animation-delay:6.4s;color:rgba(201,255,74,.7)}.item-5{animation-delay:8s;color:rgba(57,231,255,.68)}.item-6{animation-delay:9.6s}.item-7{animation-delay:11.2s;color:rgba(255,76,160,.68)}.item-8{animation-delay:12.8s}.item-9{animation-delay:14.4s;color:rgba(201,255,74,.7)}.item-10{animation-delay:16s}.item-11{animation-delay:17.6s;color:rgba(57,231,255,.7)}@keyframes brandCredits{0%{opacity:0;transform:translate(-50%,-50%) scale(.18) rotate(-6deg)}14%{opacity:1}52%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(2.7) rotate(6deg)}}.stage-footer{position:absolute;bottom:1.4rem;left:1.8rem;right:1.8rem;display:flex;justify-content:space-between;color:var(--muted);font:500 .62rem 'DM Mono',monospace;letter-spacing:.08em}.cinematic-hero+.feature-board{margin-top:3.5rem}.signal-ticker{overflow:hidden;border:1px solid var(--line);background:#101722;color:var(--muted);font:500 .65rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:2.5rem}.signal-ticker div{display:flex;width:max-content;gap:2rem;padding:.7rem 1rem;animation:drift 28s linear infinite}.signal-ticker span{color:var(--cyan)}.signal-ticker b{color:var(--pink);font-weight:500}@keyframes drift{to{transform:translateX(-35%)}}.feature-board{position:relative;border:1px solid var(--cyan);background:#0d131d;padding:1.3rem 1.5rem 1.6rem;min-height:19rem;overflow:hidden}.feature-label,.feature-content,.feature-controls{position:relative;z-index:1}.feature-label{display:flex;justify-content:space-between;color:var(--lime);font:500 .67rem 'DM Mono',monospace;letter-spacing:.1em}.feature-content{max-width:700px;margin-top:3rem}.feature-content h2{font:800 clamp(2.1rem,5vw,5rem) 'Manrope',sans-serif;letter-spacing:-.07em;line-height:.94;margin:.7rem 0}.feature-content p{color:var(--muted);margin:.7rem 0 1.3rem}.feature-controls{position:absolute;right:1.5rem;bottom:1.6rem;display:flex;gap:.5rem}.feature-controls button{width:28px;height:4px;border:0;background:var(--line);padding:0;cursor:pointer}.feature-controls button.active{background:var(--pink)}@media(max-width:760px){.cinematic-stage{height:72vh;min-height:500px;margin:0 -1.25rem}.stage-footer{left:1rem;right:1rem;bottom:1rem;font-size:.53rem}.stage-footer span:last-child{display:none}.stage-brand{left:1rem;top:1rem}.brand-item{font-size:clamp(1.9rem,9vw,4rem)}.cinematic-hero+.feature-board{margin-top:2.5rem}.signal-ticker{margin-bottom:2rem}}
</style>
<style is:global>
html[data-theme='light'] .cinematic-stage{background:rgba(238,242,246,.5);border-color:#b9c7d6}html[data-theme='light'] .stage-grid{background-image:linear-gradient(#d3dce6 1px,transparent 1px),linear-gradient(90deg,#d3dce6 1px,transparent 1px)}html[data-theme='light'] .stage-brand{color:#111827}html[data-theme='light'] .stage-title{color:rgba(17,24,39,.1)}html[data-theme='light'] .brand-item{color:rgba(17,24,39,.48)}html[data-theme='light'] .stage-footer{color:#526174}
</style>
