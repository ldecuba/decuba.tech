---
import Base from '../layouts/Base.astro';
const products=[['AZ','Azure'],['CP','Copilot'],['M365','Microsoft 365'],['BI','Power BI'],['PA','Power Apps'],['T','Teams'],['FO','Foundry'],['DV','Dataverse'],['AU','Power Automate'],['FA','Fabric'],['PP','Power Pages'],['XL','Excel']];
const posts=[{category:'AI',date:'12 Sep 2026',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'Microsoft',date:'08 Sep 2026',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'Cloud',date:'02 Sep 2026',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
---
<Base><div class="signal-ticker" aria-label="Live topics"><div><span>NOW READING</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span><b>PERSONAL SYSTEMS</b><span>FIELD NOTES</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span></div></div><section class="hero"><div class="hero-animation"><div class="animation-grid"></div><div class="animation-watermark">DECUBA<span>.TECH</span></div><div class="animation-products">{products.map(([mark,name],index)=><span class={`animation-product product-${index}`}><b>{mark}</b>{name}</span>)}</div></div><aside class="hero-aside"><strong>Live signal / 01</strong><div class="signal-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>New notes move through the system when they are ready.</span></aside></section><section class="feature-board"><div class="feature-label"><span>FEATURED NOTE</span><span id="feature-count">01 / 03</span></div><div class="feature-content"><span class="meta" id="feature-category">AI / FIELD NOTE</span><h2 id="feature-title">The useful part of AI is usually the awkward bit</h2><p id="feature-dek">A field note on what happens after the demo ends.</p><a class="read" id="feature-link" href="/posts/the-useful-part-of-ai-is-usually-the-awkward-bit">Open note →</a></div><div class="feature-controls"><button type="button" data-slide="0" aria-label="Show note 1" class="active"></button><button type="button" data-slide="1" aria-label="Show note 2"></button><button type="button" data-slide="2" aria-label="Show note 3"></button></div></section><div class="section-label">Recent dispatches / 03</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read the note →</a></article>)}</section></Base>
<script>
const notes = [{category:'AI / FIELD NOTE',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'MICROSOFT / FIELD NOTE',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'CLOUD / FIELD NOTE',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; document.querySelector('#feature-link').setAttribute('href', `/posts/${note.slug}`); document.querySelector('#feature-count').textContent=`0${index+1} / 03`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
</script>
<style>
.hero-animation{height:clamp(300px,42vw,510px);position:relative;overflow:hidden;background:rgba(8,11,17,.28);border:1px solid var(--line)}.animation-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(244,247,251,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(244,247,251,.1) 1px,transparent 1px);background-size:42px 42px}.animation-watermark{position:absolute;inset:39% 0 auto;text-align:center;color:rgba(244,247,251,.08);font:800 clamp(3rem,7vw,7rem) 'Manrope',sans-serif;letter-spacing:-.1em;transform:translateY(-50%)}.animation-watermark span{color:inherit}.animation-products{position:absolute;inset:0;perspective:850px}.animation-product{position:absolute;left:50%;top:50%;display:flex;align-items:center;gap:.65rem;white-space:nowrap;color:rgba(244,247,251,.56);font:800 clamp(1.8rem,4vw,4.6rem) 'Manrope',sans-serif;letter-spacing:-.08em;opacity:0;transform:translate(-50%,-50%) scale(.18) rotate(-5deg);animation:heroCredits 18s linear infinite}.animation-product b{display:grid;place-items:center;width:clamp(2rem,4vw,4rem);height:clamp(2rem,4vw,4rem);border:2px solid currentColor;border-radius:50%;font:500 clamp(.5rem,.8vw,.85rem) 'DM Mono',monospace;letter-spacing:0}.product-1{animation-delay:1.5s}.product-2{animation-delay:3s}.product-3{animation-delay:4.5s}.product-4{animation-delay:6s}.product-5{animation-delay:7.5s}.product-6{animation-delay:9s}.product-7{animation-delay:10.5s}.product-8{animation-delay:12s}.product-9{animation-delay:13.5s}.product-10{animation-delay:15s}.product-11{animation-delay:16.5s}@keyframes heroCredits{0%{opacity:0;transform:translate(-50%,-50%) scale(.18) rotate(-6deg)}14%{opacity:.72}52%{opacity:.72}100%{opacity:0;transform:translate(-50%,-50%) scale(2.5) rotate(6deg)}}.signal-bars{height:54px;display:flex;align-items:end;gap:5px;margin:1rem 0}.signal-bars i{display:block;width:8px;background:var(--cyan);height:20%;animation:pulse 1.8s ease-in-out infinite alternate}.signal-bars i:nth-child(2){height:60%;animation-delay:.2s}.signal-bars i:nth-child(3){height:35%;animation-delay:.4s}.signal-bars i:nth-child(4){height:90%;animation-delay:.1s}.signal-bars i:nth-child(5){height:48%;animation-delay:.5s}.signal-bars i:nth-child(6){height:75%;animation-delay:.3s}.signal-bars i:nth-child(7){height:30%;animation-delay:.7s}.signal-bars i:nth-child(8){height:66%;animation-delay:.6s}@keyframes pulse{to{height:100%;background:var(--pink)}}@media(max-width:760px){.hero-animation{height:360px}.animation-product{font-size:clamp(1.7rem,8vw,3.4rem)}.hero{display:block}.hero-aside{margin-top:1.25rem}}
</style>
