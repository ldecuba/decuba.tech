---
import Base from '../layouts/Base.astro';
const products=['Azure','Copilot','Microsoft 365','Power BI','Power Apps','Teams','Foundry','Dataverse','Power Automate','Fabric','Power Pages','Excel'];
const posts=[{category:'AI',date:'12 Sep 2026',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'Microsoft',date:'08 Sep 2026',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'Cloud',date:'02 Sep 2026',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
---
<Base><section class="product-crawl" aria-label="Products covered by decuba.tech"><div class="crawl-grid"></div><div class="crawl-brand">DECUBA<span>.TECH</span></div><div class="crawl-words">{products.map((product,index)=><span class={`crawl-word word-${index}`}>{product}</span>)}</div><div class="crawl-footer"><span>MICROSOFT CLOUD / AI / FIELD NOTES</span><span>SCROLL TO ENTER</span></div></section><div class="signal-ticker" aria-label="Live topics"><div><span>NOW READING</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span><b>PERSONAL SYSTEMS</b><span>FIELD NOTES</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span></div></div><section class="hero"><div><span class="kicker">Personal field notes · decuba.tech</span><h1>Cloud, code &amp; the <em>bits between.</em></h1><p>I'm Lisandro. I write about Microsoft cloud technology, AI, and the small decisions that product announcements tend to leave out.</p></div><aside class="hero-aside"><strong>Signal monitor / 01</strong><div class="signal-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>Products, platforms and the work around them.</span></aside></section><section class="feature-board"><div class="feature-label"><span>FEATURED NOTE</span><span id="feature-count">01 / 03</span></div><div class="feature-content"><span class="meta" id="feature-category">AI / FIELD NOTE</span><h2 id="feature-title">The useful part of AI is usually the awkward bit</h2><p id="feature-dek">A field note on what happens after the demo ends.</p><a class="read" id="feature-link" href="/posts/the-useful-part-of-ai-is-usually-the-awkward-bit">Open note →</a></div><div class="feature-controls"><button type="button" data-slide="0" aria-label="Show note 1" class="active"></button><button type="button" data-slide="1" aria-label="Show note 2"></button><button type="button" data-slide="2" aria-label="Show note 3"></button></div></section><div class="section-label">Recent dispatches / 03</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read the note →</a></article>)}</section></Base>
<script>
const notes = [{category:'AI / FIELD NOTE',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'MICROSOFT / FIELD NOTE',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'CLOUD / FIELD NOTE',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; document.querySelector('#feature-link').setAttribute('href', `/posts/${note.slug}`); document.querySelector('#feature-count').textContent=`0${index+1} / 03`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
</script>
<style>
.product-crawl{height:min(92vh,920px);min-height:600px;position:relative;overflow:hidden;background:#070a10;border:1px solid var(--line);margin:calc(clamp(3rem,7vw,7rem) * -1) calc(clamp(1.25rem,7vw,8rem) * -1) 3.5rem}.crawl-grid{position:absolute;inset:0;background-image:linear-gradient(#17212e 1px,transparent 1px),linear-gradient(90deg,#17212e 1px,transparent 1px);background-size:52px 52px;opacity:.85}.crawl-brand{position:absolute;top:2rem;left:2rem;color:#fff;font:800 clamp(1.2rem,2vw,2rem) 'Manrope',sans-serif;letter-spacing:-.06em}.crawl-brand span{color:var(--cyan)}.crawl-words{position:absolute;inset:0;perspective:800px}.crawl-word{position:absolute;left:50%;top:50%;font:800 clamp(3rem,10vw,10rem) 'Manrope',sans-serif;letter-spacing:-.09em;white-space:nowrap;color:#f4f7fb;opacity:0;transform:translate(-50%,-50%) scale(.2) rotate(-5deg);animation:cinema 18s linear infinite}.word-1{animation-delay:3s;color:var(--cyan)}.word-2{animation-delay:6s;color:var(--pink)}.word-3{animation-delay:9s}.word-4{animation-delay:12s;color:var(--lime)}.word-5{animation-delay:15s;color:var(--cyan)}.word-6{animation-delay:18s}.word-7{animation-delay:21s;color:var(--pink)}.word-8{animation-delay:24s}.word-9{animation-delay:27s;color:var(--lime)}.word-10{animation-delay:30s}.word-11{animation-delay:33s;color:var(--cyan)}@keyframes cinema{0%{opacity:0;transform:translate(-50%,-50%) scale(.2) rotate(-7deg)}12%{opacity:1}52%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(2.8) rotate(7deg)}}.crawl-footer{position:absolute;bottom:1.5rem;left:2rem;right:2rem;display:flex;justify-content:space-between;color:var(--muted);font:500 .65rem 'DM Mono',monospace;letter-spacing:.08em}.product-crawl+.signal-ticker{margin-top:0}.signal-bars{height:54px;display:flex;align-items:end;gap:5px;margin:1rem 0}.signal-bars i{display:block;width:8px;background:var(--cyan);height:20%;animation:pulse 1.8s ease-in-out infinite alternate}.signal-bars i:nth-child(2){height:60%;animation-delay:.2s}.signal-bars i:nth-child(3){height:35%;animation-delay:.4s}.signal-bars i:nth-child(4){height:90%;animation-delay:.1s}.signal-bars i:nth-child(5){height:48%;animation-delay:.5s}.signal-bars i:nth-child(6){height:75%;animation-delay:.3s}.signal-bars i:nth-child(7){height:30%;animation-delay:.7s}.signal-bars i:nth-child(8){height:66%;animation-delay:.6s}@keyframes pulse{to{height:100%;background:var(--pink)}}@media(max-width:760px){.product-crawl{height:78vh;min-height:520px;margin:calc(3.5rem * -1) -1.25rem 2.5rem}.crawl-word{font-size:clamp(2.8rem,15vw,6rem)}.crawl-footer{left:1rem;right:1rem;bottom:1rem;font-size:.57rem}.crawl-footer span:last-child{display:none}.crawl-brand{left:1rem;top:1rem}.product-crawl+.signal-ticker{margin-top:0}}
</style>
