---
import Base from '../layouts/Base.astro';
const products=['Azure','Copilot','Microsoft 365','Power BI','Power Apps','Teams','Foundry','Dataverse','Power Automate','Fabric','Power Pages','Excel'];
const posts=[{category:'AI',date:'12 Sep 2026',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'Microsoft',date:'08 Sep 2026',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'Cloud',date:'02 Sep 2026',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
---
<Base><div class="signal-ticker" aria-label="Live topics"><div><span>NOW READING</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span><b>PERSONAL SYSTEMS</b><span>FIELD NOTES</span><b>AI OPERATIONS</b><span>MICROSOFT CLOUD</span></div></div><section class="hero"><div><span class="kicker">Personal field notes · decuba.tech</span><h1>Cloud, code &amp; the <em>bits between.</em></h1><p>I'm Lisandro. I write about Microsoft cloud technology, AI, and the small decisions that product announcements tend to leave out.</p></div><aside class="hero-aside product-intro"><strong>Signal monitor / 01</strong><div class="product-stage">{products.map((product,index)=><span class={`product product-${index % 4}`}>{product}</span>)}</div><small>Products, platforms and the work around them.</small></aside></section><section class="feature-board"><div class="feature-label"><span>FEATURED NOTE</span><span id="feature-count">01 / 03</span></div><div class="feature-content"><span class="meta" id="feature-category">AI / FIELD NOTE</span><h2 id="feature-title">The useful part of AI is usually the awkward bit</h2><p id="feature-dek">A field note on what happens after the demo ends.</p><a class="read" id="feature-link" href="/posts/the-useful-part-of-ai-is-usually-the-awkward-bit">Open note →</a></div><div class="feature-controls"><button type="button" data-slide="0" aria-label="Show note 1" class="active"></button><button type="button" data-slide="1" aria-label="Show note 2"></button><button type="button" data-slide="2" aria-label="Show note 3"></button></div></section><div class="section-label">Recent dispatches / 03</div><section class="posts">{posts.map(post=><article class="post"><div class="meta">{post.category}<br />{post.date}</div><div><h2>{post.title}</h2><p>{post.dek}</p></div><a class="read" href={`/posts/${post.slug}`}>Read the note →</a></article>)}</section></Base>
<script>
const notes = [{category:'AI / FIELD NOTE',title:'The useful part of AI is usually the awkward bit',dek:'A field note on what happens after the demo ends.',slug:'the-useful-part-of-ai-is-usually-the-awkward-bit'},{category:'MICROSOFT / FIELD NOTE',title:'Power Platform is getting better at the messy middle',dek:'The features are moving quickly. The real work is still in the edges.',slug:'power-platform-is-getting-better-at-the-messy-middle'},{category:'CLOUD / FIELD NOTE',title:'A quieter way to think about Azure architecture',dek:'Notes from building systems that have to keep working after launch day.',slug:'a-quieter-way-to-think-about-azure-architecture'}];
const buttons = document.querySelectorAll('[data-slide]');
const show = (index) => { const note=notes[index]; document.querySelector('#feature-category').textContent=note.category; document.querySelector('#feature-title').textContent=note.title; document.querySelector('#feature-dek').textContent=note.dek; document.querySelector('#feature-link').setAttribute('href', `/posts/${note.slug}`); document.querySelector('#feature-count').textContent=`0${index+1} / 03`; buttons.forEach((button,i)=>button.classList.toggle('active',i===index)); };
buttons.forEach(button=>button.addEventListener('click',()=>show(Number(button.dataset.slide))));
</script>
<style>
.product-intro{min-height:270px;position:relative;overflow:hidden}.product-stage{position:absolute;inset:3.4rem 0 2.5rem;overflow:hidden;background-image:linear-gradient(rgba(57,231,255,.11) 1px,transparent 1px),linear-gradient(90deg,rgba(57,231,255,.11) 1px,transparent 1px);background-size:28px 28px}.product{position:absolute;white-space:nowrap;font:800 clamp(1.5rem,3vw,2.8rem) 'Manrope',sans-serif;letter-spacing:-.07em;color:var(--cyan);animation:credits 13s linear infinite;left:110%;top:12%;text-shadow:3px 3px 0 #192634}.product-1{top:32%;color:var(--pink);animation-duration:17s;animation-delay:-5s}.product-2{top:53%;color:var(--lime);animation-duration:15s;animation-delay:-9s}.product-3{top:75%;color:var(--cyan);animation-duration:19s;animation-delay:-2s}@keyframes credits{from{transform:translateX(0) rotate(-4deg)}to{transform:translateX(-260%) rotate(-4deg)}}.product-intro small{position:absolute;bottom:1rem;left:1.2rem;color:var(--muted);font:500 .65rem 'DM Mono',monospace}@media(max-width:760px){.product-intro{min-height:230px}.product-stage{inset:3.2rem 0 2.3rem}}
</style>
