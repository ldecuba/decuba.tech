---
import Base from '../layouts/Base.astro';
import about from '../data/about.json';
---
<Base title="About" description={about.description}>
  <article class="about-page">
    <span class="kicker">About me</span>
    <h1>{about.title}</h1>
    <div class="article-body">
      {about.body.split(/\n\s*\n/).filter(Boolean).map(paragraph => <p style="white-space: pre-line">{paragraph}</p>)}
    </div>
  </article>
</Base>

<style>
.about-page{max-width:920px}.about-page h1{max-width:28ch;margin:.8rem 0 1.2rem;font-size:clamp(2rem,3.5vw,3rem);line-height:1.15;letter-spacing:-.035em;text-wrap:balance;overflow-wrap:anywhere}.about-page .article-body{max-width:760px}.about-page .article-body p:first-child{color:var(--ink);font-size:1.3rem;font-weight:650;line-height:1.65}
</style>
