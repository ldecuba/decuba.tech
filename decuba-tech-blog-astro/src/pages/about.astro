---
import Base from '../layouts/Base.astro';
import about from '../data/about.json';
---
<Base title="About" description={about.description}>
  <article class="about-page">
    <span class="kicker">About me</span>
    <h1>{about.title}</h1>
    <div class="article-body">
      {about.body.split(/\n\s*\n/).filter(Boolean).map(paragraph => <p style="white-space: pre-line">{paragraph}</p>)}
    </div>
  </article>
</Base>

<style>
.about-page{max-width:920px}.about-page h1{max-width:12ch;margin:1rem 0 2.5rem;font-size:clamp(3rem,7vw,6.2rem);line-height:.96;letter-spacing:-.07em}.about-page .article-body{max-width:760px}.about-page .article-body p:first-child{color:var(--ink);font-size:1.3rem;font-weight:650;line-height:1.65}
</style>
