---
import Base from '../layouts/Base.astro';
import Article from '../components/Article.astro';
const data = { title: 'Article preview', description: '', date: new Date(), category: '', level: '', tags: [], bodyHtml: '<p></p>' };
---
<Base title="Article preview"><meta slot="head" name="robots" content="noindex,nofollow" /><Article data={data} /></Base>
<script>
import { renderArticleHtml } from '../lib/article-html.js';
window.addEventListener('message', (event) => {
  if (event.origin !== location.origin || event.source !== parent || event.data?.type !== 'decuba-preview') return;
  const data = event.data.post;
  if (!data || typeof data.bodyHtml !== 'string') return;
  const article = document.querySelector('.article');
  article.querySelector('h1').textContent = data.title || 'Post title';
  article.querySelector('.article-meta').textContent = `${data.primaryCategory} · ${new Date(`${data.date}T00:00:00Z`).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}`;
  article.querySelector('.article-dek').textContent = data.description;
  const tags = [data.series ? `Series: ${data.series}` : 'Field note', `Level: ${data.level}`, ...data.tags.map(tag => `#${tag}`)];
  article.querySelector('.article-tags').replaceChildren(...tags.map(text => { const span = document.createElement('span'); span.textContent = text; return span; }));
  article.querySelector('.article-body').innerHTML = renderArticleHtml(data.bodyHtml);
  document.title = `${data.seoTitle || data.title || 'Article preview'} | decuba.tech`;
});
parent.postMessage({ type: 'decuba-preview-ready' }, location.origin);
</script>
