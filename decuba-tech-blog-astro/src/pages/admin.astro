---
import about from '../data/about.json';
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><link rel="icon" href="/favicon.svg" /><title>Editor | decuba.tech</title></head>
<body>
  <a class="skip-link" href="#workspace">Skip to editor</a>
  <header class="admin-topbar"><a href="/" target="_blank" rel="noopener">decuba.tech <span aria-hidden="true">â†—</span></a><span>Publishing workspace</span></header>
  <aside class="admin-navigation">
    <a class="admin-brand" href="/" aria-label="decuba.tech home"><img src="/images/decuba-logo.png" alt="decuba.tech" /><span>CONTENT MANAGER</span></a>
    <p class="nav-caption">Your website</p>
    <nav class="admin-tabs" aria-label="Admin sections">
      <button class="active" type="button" data-tab="post" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Posts</button>
      <button type="button" data-tab="about"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>About page</button>
    </nav>
    <div class="navigation-bottom"><a href="/" target="_blank" rel="noopener">View website <span aria-hidden="true">â†—</span></a><p>Your writing. Your website.</p></div>
  </aside>
  <main id="workspace" tabindex="-1">
  <section class="admin-shell">
    <header class="workspace-header">
      <div><span class="kicker">Workspace / <span id="workspace-section">Posts</span></span><h1 id="workspace-title">Post editor</h1><p class="workspace-description" id="workspace-description">Write, review and publish your next article.</p></div>
      <div class="workspace-state"><span id="save-indicator">All changes saved locally</span><button id="new-post" type="button">New post</button></div>
    </header>
    <section class="editor-panel active" data-panel="post">
      <div class="post-manager">
        <label class="post-picker-label">Existing posts<span class="picker-row"><select id="existing-post"><option value="">Create a new post</option></select><button id="refresh-posts" type="button">Refresh</button></span></label>
      </div>
      <div class="primary-actions sticky-actions" aria-label="Post actions"><span id="post-publication-state" class="publication-state" data-state="draft" role="status">Draft · not public</span><button id="save-post" type="button">Save draft</button><button id="preview-post" type="button">Preview</button><button id="delete-post" class="danger" type="button" disabled>Delete</button><button id="publish-post" class="primary" type="button">Publish</button></div>
      <div class="notice" id="post-status" role="status" aria-live="polite"></div>
      <div class="editor-layout">
        <div class="editor-main">
          <label class="title-field"><span class="sr-only">Post title</span><textarea id="post-title" rows="1" placeholder="Add title"></textarea></label>
          <div class="slug-row"><span>Permalink</span><code>/posts/<input id="post-slug" aria-label="Post slug" />/</code><button id="reset-slug" type="button">Use title</button></div>
          <section class="content-card">
            <div id="article-toolbar" class="rich-toolbar" aria-label="Article formatting"></div>
            <textarea id="post-content" aria-label="Article content"></textarea>
            <input id="inline-image-file" type="file" accept="image/*" hidden />
            <footer class="editor-footer"><span id="word-count">0 words Â· 1 min read</span><span>Tab: indent or next cell. Alt+Up/Down: move item. Ctrl+Enter: exit list or table.</span></footer>
          </section>
          <details class="settings-card" open><summary>Excerpt</summary><label>Short description<textarea id="post-description" rows="3" maxlength="320" placeholder="A short summary used on post cards and in search results."></textarea></label><div class="field-help"><span id="excerpt-count">0 / 320</span></div></details>
          <details class="settings-card"><summary>Search appearance</summary><div class="form-grid"><label>SEO title<input id="post-seo-title" maxlength="70" placeholder="Defaults to the post title" /></label><label>SEO description<textarea id="post-seo-description" rows="3" maxlength="170" placeholder="Defaults to the excerpt"></textarea></label></div></details>
        </div>
        <aside class="editor-sidebar">
          <section class="settings-card"><h2>Publish</h2><label>Saved status<select id="post-status-field" disabled><option value="published">Published</option><option value="draft">Draft</option></select></label><label>Publish date<input id="post-date" type="date" /></label><p class="field-help">Save draft stores your work in GitHub without publishing it. Publish makes the article public on its publish date.</p></section>
          <section class="settings-card"><h2>Categories</h2><label>Primary category<select id="post-category"></select></label><label>Additional categories<select id="post-categories" multiple size="6"></select></label></section>
          <section class="settings-card"><h2>Post details</h2><label>Level<select id="post-level"><option>Beginner</option><option selected>Intermediate</option><option>Expert</option></select></label><label>Series<input id="post-series" placeholder="Optional series name" /></label><label>Tags<input id="post-tags" placeholder="Azure, AI, tutorial" /></label></section>
          <section class="settings-card"><h2>Featured image</h2><img id="feature-image-preview" class="feature-image-preview" src="/images/categories/ai.png" alt="Featured image preview" /><label>Image URL<input id="post-image" value="/images/categories/ai.png" /></label><label>Alt text<input id="post-image-alt" placeholder="Describe the image" /></label><div class="image-actions"><label class="file-button" tabindex="0" role="button">Upload image<input id="post-image-file" type="file" accept="image/*" hidden /></label><button id="use-category-image" type="button">Use category default</button></div></section>

        </aside>
      </div>
    </section>
    <section class="editor-panel" data-panel="about"><section class="settings-card about-editor"><h2>About page</h2><label>Heading<input id="about-title" value={about.title} /></label><label>Meta description<input id="about-description" value={about.description} /></label><label>Page text<textarea id="about-content" rows="18">{about.body}</textarea></label><p class="field-help">Separate paragraphs with a blank line. Text is displayed as plain text.</p><div class="primary-actions"><button id="save-about" class="primary" type="button">Publish About page</button><button id="download-about" type="button">Download text</button></div><div class="notice" id="about-status" role="status" aria-live="polite"></div></section></section>
  </section>
</main>
<dialog id="page-preview" aria-labelledby="page-preview-title"><header class="page-preview-controls"><strong id="page-preview-title">Publication preview</strong><span>Unsaved version</span><button id="toggle-preview-size" type="button">Mobile</button><button id="close-preview" type="button">Back to editor</button></header><iframe id="preview-frame" title="Full article publication preview" src="about:blank"></iframe></dialog>
</body>
</html>

<script>import '../scripts/admin.js';</script>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
html{scroll-padding-top:var(--editor-scroll-top,320px)}
.rich-editor{scroll-margin-top:var(--editor-scroll-top,320px)}
.rich-editor li{margin:.3em 0}.rich-editor h4{font-family:system-ui,sans-serif}
#page-preview{inset:0;width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:#e2e7ef;overflow:hidden}
#page-preview[open]{display:flex;flex-direction:column}#page-preview::backdrop{background:#172234}
.page-preview-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;background:#fff;border-bottom:1px solid #cbd4e1}
.page-preview-controls strong{margin-right:auto}.page-preview-controls span{font-size:12px;color:#59677b}.page-preview-controls button{min-height:44px;padding:8px 12px;background:#fff;border:1px solid #cbd4e1;border-radius:5px}
#preview-frame{display:block;flex:1;width:100%;min-height:0;border:0;margin:0 auto;background:#fff}#page-preview.mobile-preview #preview-frame{width:min(390px,100%)}
html:has(#page-preview[open]){overflow:hidden}
@media(max-width:700px){.rich-toolbar{flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain}.rich-toolbar>*{flex-shrink:0}.rich-toolbar .toolbar-group{flex-wrap:nowrap}.page-preview-controls span{display:none}}

:root{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#233047;background:#f3f5f8;color-scheme:light;--ink:#233047;--muted:#59677b;--line:#dce2eb;--panel:#fff;--cyan:#245fd6;--pink:#b42336;--lime:#176344}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;font-size:14px;line-height:1.6}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button,a,input,select,textarea{touch-action:manipulation}button{cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}button,a{transition:background .15s,color .15s,border-color .15s}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[role=button]:focus-visible{outline:3px solid #497de6;outline-offset:3px}img{max-width:100%}h1,h2,h3,p{margin-top:0}.sr-only,.skip-link:not(:focus){position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.skip-link:focus{position:fixed;top:8px;left:8px;z-index:100;background:white;color:#233047;padding:12px}
.admin-topbar{position:fixed;inset:0 0 auto;height:46px;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0 26px;background:#172234;color:#e7edf7;font-size:12px}.admin-topbar>a{font-weight:650}.admin-topbar>a span{margin-left:8px}.admin-topbar>span{color:#bfccdf}.admin-navigation{position:fixed;inset:46px auto 0 0;width:224px;background:#202e43;color:#d2dced;display:flex;flex-direction:column;padding:32px 16px 22px;z-index:30}.admin-brand{display:flex;flex-direction:column;gap:15px;padding:0 14px 32px}.admin-brand img{width:155px;filter:brightness(0) invert(1)}.admin-brand span,.nav-caption{font-size:10px;letter-spacing:.13em;color:#aebdd2}.nav-caption{padding:0 14px;margin-bottom:12px;text-transform:uppercase}.admin-tabs{display:grid;gap:6px}.admin-tabs button{display:flex;align-items:center;gap:12px;width:100%;border:0;border-radius:6px;padding:12px 14px;min-height:46px;background:transparent;color:#d2dced;text-align:left;font-weight:550}.admin-tabs button:hover{background:#2b3c55}.admin-tabs button.active{background:#354c70;color:white;box-shadow:inset 3px 0 #85aaff}.admin-tabs svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.navigation-bottom{margin-top:auto;border-top:1px solid #3b4a60;padding:20px 14px 0;font-size:12px}.navigation-bottom>a{display:flex;justify-content:space-between}.navigation-bottom p{font-size:11px;color:#aebdd2;margin:10px 0 0}
#workspace{margin:46px 0 0 224px;padding:38px clamp(24px,3.4vw,60px) 70px;min-height:calc(100vh - 46px)}.admin-shell{max-width:1520px;margin:auto}.workspace-header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:28px}.kicker{color:var(--muted);font-size:12px}.workspace-header h1{font-size:30px;font-weight:650;line-height:1.25;letter-spacing:-1px;margin:13px 0 8px}.workspace-description{color:var(--muted);margin:0;font-size:14px}.workspace-state{display:flex;align-items:center;gap:16px;font-size:12px;color:var(--muted)}#save-indicator{max-width:190px}.admin-shell button:not([class*="jodit"]),.file-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd4e1;border-radius:5px;background:white;color:#34445d;padding:10px 14px;min-height:42px;font-size:12px;font-weight:600;line-height:1.4}.admin-shell button:not([class*="jodit"]):hover,.file-button:hover{border-color:#8197bb;background:#f0f5fc;color:#174ea9}.admin-shell .primary,#new-post{background:var(--cyan);border-color:var(--cyan);color:white}.admin-shell .primary:hover,#new-post:hover{background:#194db5}.admin-shell .danger{color:var(--pink);border-color:#e3bbc1}.editor-panel{display:none}.editor-panel.active{display:block}.post-manager{padding:20px 22px;background:white;border:1px solid var(--line);border-radius:8px;margin-bottom:18px}.post-picker-label{max-width:760px}.picker-row{display:flex;gap:10px;margin-top:6px}.picker-row select{flex:1;min-width:0}.picker-row button{flex-shrink:0}.primary-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.sticky-actions{position:sticky;top:46px;z-index:20;padding:12px 0;background:#f3f5f8;border-bottom:1px solid var(--line)}.notice{color:var(--cyan);font-size:13px;margin:14px 0;overflow-wrap:anywhere}.notice:empty{display:none}.notice:not(:empty){padding:12px 16px;background:#e9f1ff;border-left:3px solid currentColor;border-radius:4px}.notice[data-type=error]{color:var(--pink);background:#fff0f1}.notice[data-type=success]{color:var(--lime);background:#eaf6ef}
.editor-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start;margin-top:24px}.editor-main{min-width:0}.editor-sidebar{display:grid;gap:18px}.title-field textarea{resize:vertical;min-height:85px;background:white!important;border:1px solid var(--line)!important;border-radius:8px;padding:20px!important;font-size:30px!important;font-weight:650!important;line-height:1.35!important;letter-spacing:-.8px}.slug-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:12px;margin:12px 0 22px}.slug-row code{display:flex;align-items:center;max-width:100%;min-width:0;color:var(--cyan)}.slug-row input{width:min(260px,36vw)!important;min-width:0;border:0!important;border-bottom:1px solid var(--line)!important;border-radius:0!important;background:transparent!important;padding:4px!important;margin:0!important;font:inherit!important}.slug-row button{padding:6px 10px;min-height:36px}.content-card,.settings-card{border:1px solid var(--line);background:white;border-radius:8px;box-shadow:0 2px 3px #1c355304}.settings-card{padding:20px}.settings-card h2,.settings-card summary{color:var(--ink);font-size:14px;font-weight:650;margin:0 0 16px}.settings-card h2{border-bottom:1px solid #e9edf3;padding-bottom:13px}.settings-card summary{cursor:pointer;margin-bottom:0;min-height:24px}.settings-card[open] summary{margin-bottom:16px}.editor-main>.settings-card{margin-top:20px}.admin-shell label{display:block;color:#45546a;font-size:12px;font-weight:550}.settings-card label+label{margin-top:16px}.admin-shell input:not([class*="jodit"]),.admin-shell select:not([class*="jodit"]),.admin-shell textarea:not([class*="jodit"]){display:block;width:100%;margin-top:7px;border:1px solid #c3cedd;border-radius:5px;background:#fff;color:var(--ink);padding:10px 11px;font-size:14px;line-height:1.5}.admin-shell input:not([class*="jodit"]),.admin-shell select:not([class*="jodit"]){min-height:42px}.admin-shell select:not([class*="jodit"])[multiple]{min-height:152px}.admin-shell textarea:not([class*="jodit"]){resize:vertical}.field-help{color:var(--muted);font-size:12px;line-height:1.65;margin:10px 0 0}.form-grid{display:grid;gap:16px;grid-template-columns:1fr 1fr}
.rich-toolbar{position:sticky;top:var(--editor-toolbar-top,112px);z-index:19;display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:12px;border-bottom:1px solid var(--line);border-radius:8px 8px 0 0;background:#f9fafc}.toolbar-group{display:flex;gap:4px;padding-left:6px;border-left:1px solid var(--line);flex-wrap:wrap}.rich-toolbar button:not([class*="jodit"]),.rich-toolbar select:not([class*="jodit"]){padding:7px 9px;min-height:36px;font-size:12px}.rich-toolbar select{width:auto;max-width:100%;margin:0}.rich-toolbar button[aria-pressed=true]{background:#dce9ff;border-color:#245fd6;color:#174ea9}.toolbar-history{margin-left:auto}.rich-editor{min-height:560px;padding:28px clamp(20px,3vw,44px);outline:0;font:400 16px/1.85 'Plus Jakarta Sans',system-ui,sans-serif;overflow-wrap:anywhere}.rich-editor:empty:before{content:attr(data-placeholder);color:var(--muted)}.rich-editor:focus{box-shadow:inset 0 0 0 2px #80a6ee}.rich-editor h2,.rich-editor h3{font-family:system-ui,sans-serif;line-height:1.35;letter-spacing:-.03em;margin:1.8em 0 .7em}.rich-editor p{margin:0 0 1.25em}.rich-editor ul,.rich-editor ol{padding-left:1.8em}.rich-editor blockquote{border-left:3px solid var(--cyan);padding-left:18px;margin:24px 0;color:var(--muted)}.rich-editor pre{white-space:pre-wrap;background:#f2f5fa;padding:16px;font:13px/1.7 monospace}.rich-editor img{display:block;max-width:100%;height:auto;margin:24px auto;cursor:pointer}.rich-editor img.is-selected{outline:3px solid var(--cyan);outline-offset:3px}.rich-editor figcaption{text-align:center;color:var(--muted);font-size:13px}.editor-footer{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line);padding:13px 18px;color:var(--muted);font-size:11px}.image-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.file-button{cursor:pointer}.feature-image-preview{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border:1px solid var(--line);border-radius:5px;margin-bottom:16px}.about-editor{max-width:920px}.about-editor textarea{min-height:460px;line-height:1.8;margin-bottom:20px}
@media(min-width:1500px){.editor-layout{grid-template-columns:minmax(0,1fr) 340px}}
@media(max-width:1150px){.admin-navigation{width:190px}#workspace{margin-left:190px;padding:28px 24px 60px}.editor-layout{grid-template-columns:minmax(0,1fr)}.editor-sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace-state{align-items:flex-end;flex-direction:column;gap:8px}}
@media(max-width:700px){.admin-topbar{padding:0 16px}.admin-topbar>span{font-size:10px}.admin-navigation{position:static;width:auto;margin-top:46px;padding:10px 14px}.admin-brand,.nav-caption,.navigation-bottom{display:none}.admin-tabs{display:flex;gap:8px}.admin-tabs button{width:auto;flex:1}.admin-tabs button.active{box-shadow:inset 0 -3px #85aaff}#workspace{margin:0;padding:24px 16px 48px}.workspace-header{align-items:stretch;flex-direction:column;gap:18px}.workspace-header h1{font-size:27px}.workspace-state{flex-direction:row;align-items:center;justify-content:space-between}#save-indicator{max-width:180px}.editor-sidebar,.form-grid{grid-template-columns:minmax(0,1fr)}.post-manager{padding:16px}.primary-actions{justify-content:flex-start}.sticky-actions{gap:6px;flex-wrap:wrap}.sticky-actions button{flex:1;min-height:44px;font-size:11px;padding:9px 10px}.title-field textarea{font-size:25px!important;padding:16px!important}.editor-layout{gap:20px}.slug-row input{width:40vw!important}.rich-toolbar{padding:10px;gap:8px;flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain}.rich-toolbar button:not([class*="jodit"]),.rich-toolbar select:not([class*="jodit"]){min-height:44px}.rich-toolbar .toolbar-group{padding-left:0;border:0;flex-wrap:nowrap}.toolbar-history{margin-left:0}.rich-editor{min-height:400px;padding:22px 18px}.editor-footer{display:block}.editor-footer span{display:block}.admin-shell input:not([class*="jodit"]),.admin-shell select:not([class*="jodit"]),.admin-shell textarea:not([class*="jodit"]){font-size:16px}.settings-card{padding:18px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>

<style is:global>
#article-toolbar{display:block;padding:0;overflow:visible;background:#f9fafc}
#article-toolbar .jodit-toolbar__box{border:0;background:transparent;border-radius:8px 8px 0 0}
#article-toolbar .jodit-toolbar-editor-collection{background:transparent}
#article-toolbar .jodit-toolbar-button{height:36px}#article-toolbar button{min-height:36px}#article-toolbar .jodit-toolbar-button__button{height:36px}
.jodit-container:not(.jodit_inline){border:0;background:#fff}
.jodit-container .jodit-workplace{min-height:400px}
.content-card .jodit-container .jodit-wysiwyg.rich-editor{padding:28px clamp(20px,3vw,44px);font:400 16px/1.85 'Plus Jakarta Sans',system-ui,sans-serif}
.jodit-wysiwyg.rich-editor [data-table-scroll]{max-width:100%;overflow-x:auto}
.jodit-wysiwyg.rich-editor table{border-collapse:collapse;max-width:100%;width:100%}
.jodit-wysiwyg.rich-editor td,.jodit-wysiwyg.rich-editor th{border:1px solid #aab8ce;padding:10px;min-width:80px;vertical-align:top}
.jodit-wysiwyg.rich-editor td p,.jodit-wysiwyg.rich-editor th p{margin:0}
.jodit-wysiwyg.rich-editor li p{margin:.25em 0}
.jodit-popup,.jodit-dialog{z-index:100!important}
.jodit-toolbar-button__button:focus-visible,.jodit-toolbar-button__trigger:focus-visible{outline:3px solid #497de6;outline-offset:-3px}
@media(max-width:700px){#article-toolbar .jodit-toolbar-button{height:44px;min-width:44px}#article-toolbar button{min-height:44px}#article-toolbar .jodit-toolbar-button__button{height:44px}.content-card .jodit-container .jodit-wysiwyg.rich-editor{padding:22px 18px}}
</style>

<style is:global>
.publication-state{display:inline-flex;align-items:center;align-self:center;gap:6px;margin-right:auto;padding:8px 12px;border:1px solid #b8c8df;border-radius:5px;background:#edf2f9;color:#304566;font-size:12px;font-weight:700;line-height:1.4}
.publication-state[data-state=published]{background:#eaf6ef;border-color:#96c3aa;color:#245f3c}
.publication-state[data-state=scheduled]{background:#fff5db;border-color:#d7be78;color:#695013}
@media(max-width:700px){.publication-state{flex-basis:100%;margin-right:0;min-height:36px}}
</style>
