---
import Base from '../layouts/Base.astro';
---
<Base title="Admin"><section class="admin-shell"><div class="admin-head"><span class="kicker">decuba.tech / workspace</span><h1>Write something worth reading.</h1><p>Create a post without opening the project files.</p><p class="security-note">Protect this page with Cloudflare Access before sharing the site.</p></div><div class="admin-tabs"><button class="active" data-tab="post">New post</button><button data-tab="about">About page</button></div><section class="editor-panel active" data-panel="post"><div class="form-grid"><label>Title<input id="post-title" placeholder="A clear, original title" /></label><label>Category<select id="post-category"><option>AI</option><option>Microsoft Copilot</option><option>Microsoft Foundry</option></select></label><label>Date<input id="post-date" type="date" /></label><label>Feature image<input id="post-image" value="/images/decuba-tech-hero.png" /><input id="post-image-file" type="file" accept="image/*" /></label></div><label>Short description<textarea id="post-description" rows="2"></textarea></label><label>Article content <span class="hint">Paste screenshots directly here</span><div id="post-content" class="rich-editor" contenteditable="true" data-placeholder="Write your article here. Paste images or screenshots directly into the text."></div></label><div class="actions"><button class="primary" id="publish-post" type="button">Publish to site</button><button id="download-post" type="button">Download Markdown</button><button id="save-post" type="button">Save draft locally</button></div><p class="status" id="post-status" role="status"></p></section><section class="editor-panel" data-panel="about"><label>About page content<textarea id="about-content" rows="18">I'm Lisandro. For over 25 years I've worked across the Microsoft stack, and these days most of my time goes into Copilot Studio and Microsoft Foundry.

This blog is where I share that journey. Technical posts on building with Copilot and Foundry, and non-technical posts on everything else that comes with this kind of work: the mistakes, the half-answers, the stuff that only makes sense after you've broken it once.

I love this technology. I love sharing it even more. None of us have this fully figured out, so let's work through it together.</textarea></label><div class="actions"><button class="primary" id="save-about" type="button">Save page draft locally</button><button id="download-about" type="button">Download text</button></div><p class="status" id="about-status" role="status"></p></section></section></Base>
<script is:inline>
const $=id=>document.querySelector(`#${id}`);const slugify=value=>value.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
document.querySelectorAll('[data-tab]').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(item=>item.classList.toggle('active',item===tab));document.querySelectorAll('[data-panel]').forEach(panel=>panel.classList.toggle('active',panel.dataset.panel===tab.dataset.tab))}));
const fields=['post-title','post-category','post-date','post-image','post-description'];localStorage.removeItem('decuba-post-draft');const collect=()=>({...Object.fromEntries(fields.map(id=>[id,$(id).value])),content:$('post-content').innerHTML});
const imagePicker=$('post-image-file');imagePicker.addEventListener('change',()=>{const file=imagePicker.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{$('post-image').value=String(reader.result);$('post-status').textContent='Feature image selected.'};reader.readAsDataURL(file)});$('post-content').addEventListener('paste',event=>{const item=[...(event.clipboardData?.items||[])].find(entry=>entry.type.startsWith('image/'));if(!item)return;event.preventDefault();const reader=new FileReader();reader.onload=()=>document.execCommand('insertHTML',false,`<img src="${reader.result}" alt="Pasted screenshot" />`);reader.readAsDataURL(item.getAsFile())});
const htmlToMarkdown=html=>{const box=document.createElement('div');box.innerHTML=html;box.querySelectorAll('br').forEach(el=>el.replaceWith('\n'));box.querySelectorAll('h2').forEach(el=>el.replaceWith(`\n## ${el.textContent}\n`));box.querySelectorAll('h3').forEach(el=>el.replaceWith(`\n### ${el.textContent}\n`));box.querySelectorAll('img').forEach(el=>{const width=el.style.width||'100%';el.replaceWith(`\n<img src="${el.src}" alt="${el.alt||'Article image'}" style="width:${width}" />\n`)});box.querySelectorAll('p').forEach(el=>el.insertAdjacentText('afterend','\n\n'));return box.textContent.replace(/\n{3,}/g,'\n\n').trim()};const makeMarkdown=()=>{const value=collect();return `---\ntitle: "${value['post-title'].replaceAll('"','\\"')}"\ndate: ${value['post-date']||new Date().toISOString().slice(0,10)}\ncategory: "${value['post-category']}"\ndescription: "${value['post-description'].replaceAll('"','\\"')}"\nfeatureImage: "${value['post-image']}"\npublished: true\n---\n\n${htmlToMarkdown(value.content)}\n`};window.makePostMarkdown=makeMarkdown;
const download=(name,text,type)=>{const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([text],{type}));link.download=name;link.click();URL.revokeObjectURL(link.href)};$('save-post').addEventListener('click',()=>{localStorage.setItem('decuba-post-draft',JSON.stringify(collect()));$('post-status').textContent='Draft saved in this browser.'});$('download-post').addEventListener('click',()=>{const value=collect();if(!value['post-title'])return $('post-status').textContent='Add a title first.';download(`${slugify(value['post-title'])}.md`,makeMarkdown(),'text/markdown');$('post-status').textContent='Markdown downloaded.'});
$('publish-post').addEventListener('click',async()=>{const value=collect();if(!value['post-title'])return $('post-status').textContent='Add a title first.';const button=$('publish-post');button.disabled=true;$('post-status').textContent='Publishing to GitHub...';try{const response=await fetch('/api/publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:`${slugify(value['post-title'])}.md`,content:makeMarkdown()})});const result=await response.json().catch(()=>({}));$('post-status').textContent=response.ok?'Published to GitHub. Cloudflare will deploy it shortly.':(result.error||`Publishing failed (${response.status}).`)}catch(error){$('post-status').textContent='Publishing failed. Check the Cloudflare deployment and GITHUB_TOKEN.'}finally{button.disabled=false}});
const aboutDraft=localStorage.getItem('decuba-about-draft');if(aboutDraft)$('about-content').value=aboutDraft;$('save-about').addEventListener('click',()=>{localStorage.setItem('decuba-about-draft',$('about-content').value);$('about-status').textContent='About draft saved locally.'});$('download-about').addEventListener('click',()=>{download('about-copy.txt',$('about-content').value,'text/plain');$('about-status').textContent='About copy downloaded.'});
</script>
<script is:inline>
const categoryImages={'Microsoft 365 Copilot':'/images/categories/microsoft-365-copilot.png','Copilot Studio':'/images/categories/copilot-studio.png','Microsoft Foundry':'/images/categories/microsoft-foundry.png','Power Platform':'/images/categories/power-platform.png','Azure AI':'/images/categories/azure-ai.png','AI':'/images/categories/ai.png'};
const categorySelect=$('post-category');
categorySelect.replaceChildren(...Object.keys(categoryImages).map(name=>{const option=document.createElement('option');option.textContent=name;return option}));
categorySelect.addEventListener('change',()=>{if(!$('post-image').dataset.manualImage){$('post-image').value=categoryImages[categorySelect.value]||categoryImages.AI}});
$('post-image').addEventListener('input',()=>{$('post-image').dataset.manualImage='true'});
if(!$('post-image').value||$('post-image').value==='/images/decuba-tech-hero.png'){$('post-image').value=categoryImages[categorySelect.value]||categoryImages.AI}
const editor=$('post-content');const imageTools=document.createElement('div');imageTools.className='image-tools';imageTools.innerHTML='<span>Selected image width</span><input id="image-width" type="range" min="25" max="100" value="100" step="5"><output id="image-width-value">100%</output>';editor.before(imageTools);let selectedImage=null;editor.addEventListener('click',event=>{if(event.target.tagName!=='IMG'){selectedImage=null;return}selectedImage=event.target;const width=parseInt(selectedImage.style.width||'100',10);$('image-width').value=width;$('image-width-value').value=`${width}%`});$('image-width').addEventListener('input',event=>{if(!selectedImage)return;selectedImage.style.width=`${event.target.value}%`;$('image-width-value').value=`${event.target.value}%`});
</script>
<script is:inline>
const postPicker=document.createElement('select');postPicker.id='existing-post';postPicker.innerHTML='<option value="">Edit an existing post...</option>';postPicker.style.marginBottom='1rem';postPicker.style.width='100%';postPicker.style.padding='.8rem';postPicker.style.background='var(--panel)';postPicker.style.color='var(--ink)';postPicker.style.border='1px solid var(--line)';document.querySelector('[data-panel="post"] .form-grid').before(postPicker);const frontmatter=text=>{const match=text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);const data={};if(!match)return {data,body:text};match[1].split('\n').forEach(line=>{const index=line.indexOf(':');if(index<0)return;data[line.slice(0,index).trim()]=line.slice(index+1).trim().replace(/^"|"$/g,'')});return {data,body:match[2].trim()}};const escapeHtml=value=>value.replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));const markdownToHtml=text=>text.split(/\n\n+/).map(block=>{const image=block.match(/^!\[([^\]]*)\]\((data:image\/[^)]+)\)$/);if(image)return `<img src="${image[2]}" alt="${escapeHtml(image[1])}" />`;if(block.startsWith('### '))return `<h3>${escapeHtml(block.slice(4))}</h3>`;if(block.startsWith('## '))return `<h2>${escapeHtml(block.slice(3))}</h2>`;return `<p>${escapeHtml(block).replace(/\n/g,'<br>')}</p>`}).join('');fetch('/api/posts').then(response=>response.ok?response.json():null).then(result=>{result?.posts?.forEach(post=>{const option=document.createElement('option');option.value=post.filename;option.textContent=post.filename.replace(/\.md$/,'');postPicker.append(option)})}).catch(()=>{});postPicker.addEventListener('change',async()=>{if(!postPicker.value)return;const result=await (await fetch('/api/posts')).json();const post=result.posts.find(item=>item.filename===postPicker.value);if(!post)return;const parsed=frontmatter(post.content);$('post-title').value=parsed.data.title||'';$('post-category').value=parsed.data.category||'AI';$('post-date').value=parsed.data.date||'';$('post-image').value=parsed.data.featureImage||'/images/decuba-tech-hero.png';$('post-description').value=parsed.data.description||'';$('post-content').innerHTML=markdownToHtml(parsed.body);$('post-status').textContent='Existing post loaded. Edit it and publish to update.'});
</script>
<script is:inline>
const levelField=document.createElement('label');levelField.textContent='Level';const levelSelect=document.createElement('select');levelSelect.id='post-level';['Beginner','Intermediate','Expert'].forEach(level=>{const option=document.createElement('option');option.value=level;option.textContent=level;if(level==='Intermediate')option.selected=true;levelSelect.append(option)});levelField.append(levelSelect);document.querySelector('#post-category').closest('label').after(levelField);const originalMakeMarkdown=window.makePostMarkdown;window.makePostMarkdown=()=>originalMakeMarkdown().replace(/(category:.*\n)/,`$1level: "${levelSelect.value}"\n`);
const postActions=document.querySelector('[data-panel="post"] .actions');
const updateButton=document.createElement('button');updateButton.type='button';updateButton.textContent='Update post';updateButton.dataset.updatePost='true';updateButton.disabled=true;postActions.insertBefore(updateButton,postActions.children[1]);
const quickActions=document.createElement('div');quickActions.className='quick-actions';quickActions.innerHTML='<span>Actions</span><button type="button" data-quick="publish">Publish to site</button><button type="button" data-quick="update" disabled>Update post</button><button type="button" data-quick="save">Save draft locally</button>';document.querySelector('[data-panel="post"] .form-grid').before(quickActions);
quickActions.querySelector('[data-quick="publish"]').addEventListener('click',()=>document.querySelector('#publish-post').click());quickActions.querySelector('[data-quick="save"]').addEventListener('click',()=>document.querySelector('#save-post').click());quickActions.querySelector('[data-quick="update"]').addEventListener('click',()=>updateButton.click());
const picker=document.querySelector('#existing-post');picker?.addEventListener('change',()=>setTimeout(()=>{window.editingFilename=picker.value;document.querySelectorAll('[data-update-post], [data-quick="update"]').forEach(button=>button.disabled=!window.editingFilename)},100));
updateButton.addEventListener('click',async()=>{if(!window.editingFilename)return;const status=document.querySelector('#post-status');updateButton.disabled=true;status.textContent='Updating post on GitHub...';try{const response=await fetch('/api/publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:window.editingFilename,content:window.makePostMarkdown()})});const result=await response.json().catch(()=>({}));status.textContent=response.ok?'Post updated on GitHub. Cloudflare will deploy it shortly.':(result.error||`Update failed (${response.status}).`)}catch(error){status.textContent='Update failed. Check the Cloudflare deployment and GITHUB_TOKEN.'}finally{updateButton.disabled=!window.editingFilename;document.querySelector('[data-quick="update"]').disabled=!window.editingFilename}});
</script>
<style is:global>
.admin-shell{max-width:900px}.security-note{color:var(--pink)!important;font:500 .72rem 'DM Mono',monospace!important}.admin-head h1{font:800 clamp(2.8rem,6vw,5.8rem) 'Manrope',sans-serif;line-height:.92;letter-spacing:-.07em;max-width:10ch;margin:1rem 0}.admin-head p{color:var(--muted);font-size:1.05rem}.admin-tabs{display:flex;gap:.5rem;border-bottom:1px solid var(--line);margin:3rem 0 2rem}.admin-tabs button,.actions button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:.7rem .9rem;cursor:pointer;font:500 .7rem 'DM Mono',monospace;text-transform:uppercase}.admin-tabs button.active,.admin-tabs button:hover,.actions .primary{border-color:var(--cyan);color:var(--cyan)}.editor-panel{display:none}.editor-panel.active{display:block}.form-grid{display:grid;grid-template-columns:2fr 1fr;gap:1rem}.editor-panel label{display:block;color:var(--muted);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:1.2rem}.editor-panel input,.editor-panel select,.editor-panel textarea{display:block;width:100%;margin-top:.45rem;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:.8rem;font:400 .95rem 'Manrope',sans-serif}.editor-panel input[type=file]{padding:.55rem}.editor-panel textarea{resize:vertical;line-height:1.6}.hint{color:var(--cyan);text-transform:none;margin-left:.4rem}.rich-editor{min-height:360px;margin-top:.45rem;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:1rem;font:400 .95rem 'Manrope',sans-serif;line-height:1.65;outline:0}.rich-editor:empty:before{content:attr(data-placeholder);color:var(--muted)}.rich-editor:focus{border-color:var(--cyan)}.rich-editor img{display:block;max-width:100%;height:auto;margin:1rem 0;border:1px solid var(--line)}.actions{display:flex;gap:.7rem;flex-wrap:wrap}.status{min-height:1.4rem;color:var(--lime);font:500 .7rem 'DM Mono',monospace;margin-top:1rem}@media(max-width:600px){.form-grid{grid-template-columns:1fr}}
.quick-actions{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;margin:0 0 1.5rem;padding:.8rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.quick-actions span{color:var(--muted);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;margin-right:auto}.quick-actions button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:.65rem .8rem;cursor:pointer;font:500 .68rem 'DM Mono',monospace;text-transform:uppercase}.quick-actions button:first-of-type,.quick-actions button:hover:not(:disabled){border-color:var(--cyan);color:var(--cyan)}.quick-actions button:disabled,.actions button:disabled{opacity:.45;cursor:not-allowed}
</style>
