---
import Base from '../layouts/Base.astro';
---
<Base title="Admin"><section class="admin-shell"><div class="admin-head"><span class="kicker">decuba.tech / workspace</span><h1>Write something worth reading.</h1><p>Create a post or update a page without opening the project files.</p></div><div class="admin-tabs" role="tablist"><button class="active" data-tab="post">New post</button><button data-tab="about">About page</button></div><section class="editor-panel active" data-panel="post"><div class="form-grid"><label>Title<input id="post-title" placeholder="A clear, original title" /></label><label>Category<select id="post-category"><option>AI</option><option>Microsoft Copilot</option><option>Microsoft Foundry</option></select></label><label>Date<input id="post-date" type="date" /></label><label>Feature image<input id="post-image" value="/images/decuba-tech-hero.png" /></label></div><label>Short description<textarea id="post-description" rows="2" placeholder="The line readers see before opening the post."></textarea></label><label>Article content<textarea id="post-content" rows="14" placeholder="Write in Markdown. Use ## for section headings."></textarea></label><div class="actions"><button class="primary" id="download-post" type="button">Download Markdown</button><button id="save-post" type="button">Save draft locally</button></div><p class="status" id="post-status" role="status"></p></section><section class="editor-panel" data-panel="about"><label>About page content<textarea id="about-content" rows="18">I'm Lisandro. For over 25 years I've worked across the Microsoft stack, and these days most of my time goes into Copilot Studio and Microsoft Foundry.

This blog is where I share that journey. Technical posts on building with Copilot and Foundry, and non-technical posts on everything else that comes with this kind of work: the mistakes, the half-answers, the stuff that only makes sense after you've broken it once.

I love this technology. I love sharing it even more. None of us have this fully figured out, so let's work through it together.</textarea></label><div class="actions"><button class="primary" id="save-about" type="button">Save page draft locally</button><button id="download-about" type="button">Download text</button></div><p class="status" id="about-status" role="status"></p></section></section></Base>
<script>
const $=(id)=>document.querySelector(`#${id}`);const slugify=(value)=>value.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');const tabs=document.querySelectorAll('[data-tab]');const panels=document.querySelectorAll('[data-panel]');tabs.forEach(tab=>tab.addEventListener('click',()=>{tabs.forEach(item=>item.classList.toggle('active',item===tab));panels.forEach(panel=>panel.classList.toggle('active',panel.dataset.panel===tab.dataset.tab));}));
const postFields=['post-title','post-category','post-date','post-image','post-description','post-content'];const storedPost=JSON.parse(localStorage.getItem('decuba-post-draft')||'null');if(storedPost)postFields.forEach(id=>{if(storedPost[id]!==undefined)$(id).value=storedPost[id]});const collect=()=>Object.fromEntries(postFields.map(id=>[id,$(id).value]));$('save-post').addEventListener('click',()=>{localStorage.setItem('decuba-post-draft',JSON.stringify(collect()));$('post-status').textContent='Draft saved in this browser.'});$('download-post').addEventListener('click',()=>{const value=collect();if(!value['post-title'])return $('post-status').textContent='Add a title before downloading.';const markdown=`---\ntitle: "${value['post-title'].replaceAll('"','\\"')}"\ndate: ${value['post-date']||new Date().toISOString().slice(0,10)}\ncategory: "${value['post-category']}"\ndescription: "${value['post-description'].replaceAll('"','\\"')}"\nfeatureImage: "${value['post-image']}"\npublished: true\n---\n\n${value['post-content']}\n`;const blob=new Blob([markdown],{type:'text/markdown'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=`${slugify(value['post-title'])}.md`;link.click();URL.revokeObjectURL(link.href);$('post-status').textContent='Markdown file ready. Add it to src/content/posts/ and push to publish.'});
const storedAbout=localStorage.getItem('decuba-about-draft');if(storedAbout)$('about-content').value=storedAbout;$('save-about').addEventListener('click',()=>{localStorage.setItem('decuba-about-draft',$('about-content').value);$('about-status').textContent='About draft saved in this browser.'});$('download-about').addEventListener('click',()=>{const blob=new Blob([$('about-content').value],{type:'text/plain'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='about-copy.txt';link.click();URL.revokeObjectURL(link.href);$('about-status').textContent='About copy downloaded.'});
</script>
<style is:global>
.admin-shell{max-width:900px}.admin-head h1{font:800 clamp(2.8rem,6vw,5.8rem) 'Manrope',sans-serif;line-height:.92;letter-spacing:-.07em;max-width:10ch;margin:1rem 0}.admin-head p{color:var(--muted);font-size:1.05rem}.admin-tabs{display:flex;gap:.5rem;border-bottom:1px solid var(--line);margin:3rem 0 2rem}.admin-tabs button,.actions button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:.7rem .9rem;cursor:pointer;font:500 .7rem 'DM Mono',monospace;text-transform:uppercase}.admin-tabs button.active,.admin-tabs button:hover,.actions .primary{border-color:var(--cyan);color:var(--cyan)}.editor-panel{display:none}.editor-panel.active{display:block}.form-grid{display:grid;grid-template-columns:2fr 1fr;gap:1rem}.editor-panel label{display:block;color:var(--muted);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:1.2rem}.editor-panel input,.editor-panel select,.editor-panel textarea{display:block;width:100%;margin-top:.45rem;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:.8rem;font:400 .95rem 'Manrope',sans-serif}.editor-panel textarea{resize:vertical;line-height:1.6}.actions{display:flex;gap:.7rem;flex-wrap:wrap}.actions .primary{background:transparent}.status{min-height:1.4rem;color:var(--lime);font:500 .7rem 'DM Mono',monospace;margin-top:1rem}@media(max-width:600px){.form-grid{grid-template-columns:1fr}}
</style>
