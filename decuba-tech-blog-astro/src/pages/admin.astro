---
import Base from '../layouts/Base.astro';
---

<Base title="Admin">
  <section class="admin-shell">
    <header class="workspace-header">
      <div><span class="kicker">decuba.tech / publishing workspace</span><h1>Post editor</h1></div>
      <div class="workspace-state"><span id="save-indicator">All changes saved locally</span><button id="new-post" type="button">New post</button></div>
    </header>
    <nav class="admin-tabs" aria-label="Admin sections"><button class="active" type="button" data-tab="post">Posts</button><button type="button" data-tab="about">About page</button></nav>
    <section class="editor-panel active" data-panel="post">
      <div class="post-manager">
        <label class="post-picker-label">Existing posts<span class="picker-row"><select id="existing-post"><option value="">Create a new post</option></select><button id="refresh-posts" type="button">Refresh</button></span></label>
        <div class="primary-actions"><button id="save-post" type="button">Save browser draft</button><button id="preview-post" type="button">Preview</button><button id="delete-post" class="danger" type="button" disabled>Delete</button><button id="publish-post" class="primary" type="button">Publish</button></div>
      </div>
      <div class="notice" id="post-status" role="status" aria-live="polite"></div>
      <div class="editor-layout">
        <div class="editor-main">
          <label class="title-field"><span class="sr-only">Post title</span><textarea id="post-title" rows="1" placeholder="Add title"></textarea></label>
          <div class="slug-row"><span>Permalink</span><code>/posts/<input id="post-slug" aria-label="Post slug" />/</code><button id="reset-slug" type="button">Use title</button></div>
          <section class="content-card">
            <div class="rich-toolbar" role="toolbar" aria-label="Article formatting">
              <select id="block-format" aria-label="Text style"><option value="p">Paragraph</option><option value="h2">Heading 2</option><option value="h3">Heading 3</option><option value="blockquote">Quote</option><option value="pre">Code block</option></select>
              <span class="toolbar-group"><button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="underline"><u>U</u></button><button type="button" data-command="removeFormat">Clear</button></span>
              <span class="toolbar-group"><button type="button" data-command="insertUnorderedList">• List</button><button type="button" data-command="insertOrderedList">1. List</button><button type="button" data-command="outdent">←</button><button type="button" data-command="indent">→</button></span>
              <span class="toolbar-group"><button type="button" data-command="justifyLeft">Left</button><button type="button" data-command="justifyCenter">Center</button><button type="button" data-command="justifyRight">Right</button></span>
              <span class="toolbar-group"><button id="insert-link" type="button">Link</button><button id="insert-inline-image" type="button">Image</button><select id="image-width" aria-label="Selected image width" disabled><option value="25">25%</option><option value="50">50%</option><option value="75">75%</option><option value="100" selected>100%</option></select><button id="remove-image" type="button" disabled>Remove image</button><button type="button" data-command="insertHorizontalRule">Divider</button></span>
              <span class="toolbar-group toolbar-history"><button type="button" data-command="undo">Undo</button><button type="button" data-command="redo">Redo</button></span>
              <input id="inline-image-file" type="file" accept="image/*" hidden />
            </div>
            <div id="post-content" class="rich-editor" contenteditable="true" data-placeholder="Start writing your post…"></div>
            <footer class="editor-footer"><span id="word-count">0 words · 1 min read</span><span>Tip: paste screenshots directly into the editor.</span></footer>
          </section>
          <details class="settings-card" open><summary>Excerpt</summary><label>Short description<textarea id="post-description" rows="3" maxlength="320" placeholder="A short summary used on post cards and in search results."></textarea></label><div class="field-help"><span id="excerpt-count">0 / 320</span></div></details>
          <details class="settings-card"><summary>Search appearance</summary><div class="form-grid"><label>SEO title<input id="post-seo-title" maxlength="70" placeholder="Defaults to the post title" /></label><label>SEO description<textarea id="post-seo-description" rows="3" maxlength="170" placeholder="Defaults to the excerpt"></textarea></label></div></details>
        </div>
        <aside class="editor-sidebar">
          <section class="settings-card"><h2>Publish</h2><label>Status<select id="post-status-field"><option value="published">Published</option><option value="draft">Draft</option></select></label><label>Publish date<input id="post-date" type="date" /></label><p class="field-help">Drafts are saved to GitHub but hidden from the public site.</p></section>
          <section class="settings-card"><h2>Categories</h2><label>Primary category<select id="post-category"></select></label><label>Additional categories<select id="post-categories" multiple size="6"></select></label></section>
          <section class="settings-card"><h2>Post details</h2><label>Level<select id="post-level"><option>Beginner</option><option selected>Intermediate</option><option>Expert</option></select></label><label>Series<input id="post-series" placeholder="Optional series name" /></label><label>Tags<input id="post-tags" placeholder="Azure, AI, tutorial" /></label></section>
          <section class="settings-card"><h2>Featured image</h2><img id="feature-image-preview" class="feature-image-preview" src="/images/categories/ai.png" alt="Featured image preview" /><label>Image URL<input id="post-image" value="/images/categories/ai.png" /></label><label>Alt text<input id="post-image-alt" placeholder="Describe the image" /></label><div class="image-actions"><label class="file-button">Upload image<input id="post-image-file" type="file" accept="image/*" hidden /></label><button id="use-category-image" type="button">Use category default</button></div></section>
          <section class="settings-card preview-card"><div class="preview-heading"><h2>Live preview</h2><button id="toggle-preview-size" type="button">Mobile</button></div><article id="live-preview"><div class="preview-meta">AI · Today</div><img class="preview-image" src="/images/categories/ai.png" alt="" /><h3>Post title</h3><p class="preview-description">Your excerpt will appear here.</p><div class="preview-body"></div></article></section>
        </aside>
      </div>
    </section>
    <section class="editor-panel" data-panel="about"><section class="settings-card about-editor"><h2>About page copy</h2><textarea id="about-content" rows="18">I'm Lisandro. For over 25 years I've worked across the Microsoft stack, and these days most of my time goes into Copilot Studio and Microsoft Foundry.

This blog is where I share that journey. Technical posts on building with Copilot and Foundry, and non-technical posts on everything else that comes with this kind of work: the mistakes, the half-answers, the stuff that only makes sense after you've broken it once.

I love this technology. I love sharing it even more. None of us have this fully figured out, so let's work through it together.</textarea><div class="primary-actions"><button id="save-about" class="primary" type="button">Save locally</button><button id="download-about" type="button">Download text</button></div><div class="notice" id="about-status" role="status"></div></section></section>
  </section>
</Base>

<script is:inline src="/admin.js?v=microsoft-copilot"></script>

<style is:global>
  .admin-shell{width:100%;max-width:none}.workspace-header{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--line)}.workspace-header h1{font:800 clamp(2.2rem,5vw,4.5rem) 'Manrope',sans-serif;line-height:.95;letter-spacing:-.06em;margin:.65rem 0 0}.workspace-state{display:flex;align-items:center;gap:1rem;color:var(--muted);font:500 .67rem 'DM Mono',monospace;text-transform:uppercase}.admin-tabs{display:flex;gap:.5rem;margin:1.5rem 0;border-bottom:1px solid var(--line)}.admin-shell button,.file-button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:.68rem .85rem;cursor:pointer;font:500 .68rem 'DM Mono',monospace;text-transform:uppercase}.admin-shell button:hover,.file-button:hover{border-color:var(--cyan);color:var(--cyan)}.admin-shell button:disabled{opacity:.4;cursor:not-allowed}.admin-shell .primary{border-color:var(--cyan);background:var(--cyan);color:#071017}.admin-shell .danger{border-color:var(--pink);color:var(--pink)}.admin-tabs button.active{border-color:var(--cyan);color:var(--cyan)}.editor-panel{display:none}.editor-panel.active{display:block}.post-manager{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1rem}.post-picker-label{flex:1;max-width:620px}.picker-row{display:flex;gap:.5rem;margin-top:.4rem}.picker-row select{flex:1}.primary-actions{display:flex;gap:.55rem;flex-wrap:wrap;justify-content:flex-end}.notice{min-height:1.5rem;margin:.8rem 0;color:var(--cyan);font:500 .7rem 'DM Mono',monospace}.notice[data-type="error"]{color:var(--pink)}.notice[data-type="success"]{color:var(--lime)}
  .editor-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:1.4rem;align-items:start}.editor-main{min-width:0;padding:0}.editor-sidebar{display:grid;gap:1rem;position:sticky;top:92px}.title-field{margin:0}.title-field textarea{overflow:hidden;resize:none;min-height:70px;border:0!important;background:transparent!important;padding:.25rem 0!important;font:800 clamp(2rem,5vw,4rem) 'Manrope',sans-serif!important;line-height:1!important;letter-spacing:-.055em}.slug-row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;color:var(--muted);font:500 .65rem 'DM Mono',monospace;margin:.4rem 0 1.2rem}.slug-row code{display:flex;align-items:center;color:var(--cyan)}.slug-row input{width:min(380px,50vw);border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--cyan);padding:.25rem;font:inherit}.slug-row button{padding:.35rem .5rem}.content-card,.settings-card{border:1px solid var(--line);background:var(--panel)}.settings-card{padding:1rem}.settings-card h2,.settings-card summary{font:800 1rem 'Manrope',sans-serif;color:var(--ink);margin:0 0 1rem}.settings-card summary{cursor:pointer}.settings-card[open] summary{margin-bottom:1rem}.editor-main>.settings-card{margin-top:1rem}
  .rich-toolbar{position:sticky;top:78px;z-index:10;display:flex;align-items:center;gap:.38rem;flex-wrap:wrap;padding:.55rem;border-bottom:1px solid var(--line);background:rgba(14,20,30,.97)}.toolbar-group{display:flex;gap:.3rem;padding-left:.38rem;border-left:1px solid var(--line)}.toolbar-history{margin-left:auto}.rich-toolbar button,.rich-toolbar select{padding:.42rem .5rem;font-size:.62rem}.rich-editor{min-height:620px;width:100%;padding:clamp(1.2rem,3vw,2.5rem);outline:0;color:var(--ink);font:400 1.05rem/1.8 'Manrope',sans-serif}.rich-editor:empty:before{content:attr(data-placeholder);color:var(--muted)}.rich-editor:focus{box-shadow:inset 0 0 0 1px var(--cyan)}.rich-editor h2,.rich-editor h3{font-family:'Manrope',sans-serif;line-height:1.1;letter-spacing:-.035em;margin:2rem 0 .75rem}.rich-editor p{margin:0 0 1.25rem}.rich-editor ul,.rich-editor ol{padding-left:1.8rem}.rich-editor blockquote{border-left:3px solid var(--pink);margin:1.5rem 0;padding:.2rem 0 .2rem 1.2rem;color:var(--muted)}.rich-editor pre{white-space:pre-wrap;background:#080c12;border:1px solid var(--line);padding:1rem;font:400 .82rem/1.6 'DM Mono',monospace}.rich-editor img{display:block;max-width:100%;height:auto;margin:1.5rem auto;cursor:pointer}.rich-editor img.is-selected{outline:3px solid var(--cyan);outline-offset:3px}.rich-editor figcaption{text-align:center;color:var(--muted);font-size:.78rem}.editor-footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding:.65rem .85rem;color:var(--muted);font:500 .62rem 'DM Mono',monospace}
  .admin-shell label{display:block;color:var(--muted);font:500 .66rem 'DM Mono',monospace;text-transform:uppercase}.admin-shell input,.admin-shell select,.admin-shell textarea{display:block;width:100%;margin-top:.4rem;border:1px solid var(--line);background:#0a1018;color:var(--ink);padding:.72rem;font:400 .9rem 'Manrope',sans-serif}.admin-shell select[multiple]{min-height:148px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field-help{color:var(--muted);font:400 .68rem/1.5 'DM Mono',monospace;margin:.6rem 0 0}.image-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.7rem}.feature-image-preview{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border:1px solid var(--line);margin-bottom:1rem}.preview-heading{display:flex;align-items:center;justify-content:space-between}.preview-heading button{padding:.35rem .5rem}.preview-card{overflow:hidden}.preview-card article{width:100%;transition:max-width .2s;margin:0 auto}.preview-card article.mobile-preview{max-width:390px}.preview-image{display:block;width:100%;height:auto;max-height:180px;object-fit:cover;margin:.75rem 0}.preview-meta{color:var(--pink);font:500 .6rem 'DM Mono',monospace;text-transform:uppercase}.preview-card h3{font:800 1.7rem/1 'Manrope',sans-serif;letter-spacing:-.05em;margin:.7rem 0}.preview-description{color:var(--muted);line-height:1.5}.preview-body{border-top:1px solid var(--line);margin-top:1rem;padding-top:1rem;max-height:430px;overflow:auto;font-size:.86rem;line-height:1.65}.preview-body img{max-width:100%;height:auto}.about-editor{max-width:900px}.about-editor textarea{min-height:460px;line-height:1.7}
  @media(max-width:1050px){.editor-layout{grid-template-columns:1fr}.editor-sidebar{position:static;grid-template-columns:repeat(2,minmax(0,1fr))}.preview-card{grid-column:1/-1}.rich-editor{min-height:500px}}
  @media(max-width:700px){.workspace-header,.post-manager{align-items:stretch;flex-direction:column}.workspace-state{justify-content:space-between}.primary-actions{justify-content:flex-start}.editor-sidebar,.form-grid{grid-template-columns:1fr}.rich-toolbar{top:70px}.toolbar-history{margin-left:0}.editor-footer{display:block}.editor-footer span{display:block;margin:.2rem 0}.slug-row code{max-width:100%;overflow:hidden}.slug-row input{width:58vw}}
</style>
