---
import Base from '../layouts/Base.astro';
---
<Base title="Admin"><section class="admin-shell"><div class="admin-head"><span class="kicker">decuba.tech / workspace</span><h1>Write something worth reading.</h1><p>Create a post without opening the project files.</p><p class="security-note">Protect this page with Cloudflare Access before sharing the site.</p></div><div class="admin-tabs"><button class="active" data-tab="post">New post</button><button data-tab="about">About page</button></div><section class="editor-panel active" data-panel="post"><div class="form-grid"><label>Title<input id="post-title" placeholder="A clear, original title" /></label><label>Category<select id="post-category"><option>AI</option><option>Microsoft Copilot</option><option>Microsoft Foundry</option></select></label><label>Date<input id="post-date" type="date" /></label><label>Feature image<input id="post-image" value="/images/decuba-tech-hero.png" /></label></div><label>Short description<textarea id="post-description" rows="2"></textarea></label><label>Article content <span class="hint">Paste screenshots directly here</span><div id="post-content" class="rich-editor" contenteditable="true" data-placeholder="Write your article here. Paste images or screenshots directly into the text."></div></label><div class="actions"><button class="primary" id="download-post" type="button">Download Markdown</button><button id="save-post" type="button">Save draft locally</button></div><p class="status" id="post-status" role="status"></p></section><section class="editor-panel" data-panel="about"><label>About page content<textarea id="about-content" rows="18">I'm Lisandro. For over 25 years I've worked across the Microsoft stack, and these days most of my time goes into Copilot Studio and Microsoft Foundry.

This blog is where I share that journey. Technical posts on building with Copilot and Foundry, and non-technical posts on everything else that comes with this kind of work: the mistakes, the half-answers, the stuff that only makes sense after you've broken it once.

I love this technology. I love sharing it even more. None of us have this fully figured out, so let's work through it together.</textarea></label><div class="actions"><button class="primary" id="save-about" type="button">Save page draft locally</button><button id="download-about" type="button">Download text</button></div><p class="status" id="about-status" role="status"></p></section></section></Base>
<script>
const $=(id)=>document.querySelector(`#${id}`);const slugify=(value)=>value.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');const tabs=document.querySelectorAll('[data-tab]');const panels=document.querySelectorAll('[data-panel]');tabs.forEach(tab=>tab.addEventListener('click',()=>{tabs.forEach(item=>item.classList.toggle('active',item===tab));panels.forEach(panel=>panel.classList.toggle('active',panel.dataset.panel===tab.dataset.tab));}));
const fields=['post-title','post-category','post-date','post-image','post-description'];const publishButton=document.createElement('button');publishButton.className='primary';publishButton.type='button';publishButton.textContent='Publish to site';document.querySelector('.actions').prepend(publishButton);const stored=JSON.parse(localStorage.getItem('decuba-post-draft')||'null');if(stored)fields.forEach(id=>{if(stored[id]!==undefined)$(id).value=stored[id]});if(stored?.content)$('post-content').innerHTML=stored.content;const collect=()=>({...Object.fromEntries(fields.map(id=>[id,$(id).value])),content:$('post-content').innerHTML});
$('post-content').addEventListener('paste',(event)=>{const item=[...(event.clipboardData?.items||[])].find(entry=>entry.type.startsWith('image/'));if(!item)return;event.preventDefault();const reader=new FileReader();reader.onload=()=>document.execCommand('insertHTML',false,`<img src="${reader.result}" alt="Pasted screenshot" />`);reader.readAsDataURL(item.getAsFile())});
const htmlToMarkdown=(html)=>{const box=document.createElement('div');box.innerHTML=html;box.querySelectorAll('br').forEach(el=>el.replaceWith('\n'));box.querySelectorAll('h2').forEach(el=>el.replaceWith(`\n## ${el.textContent}\n`));box.querySelectorAll('h3').forEach(el=>el.replaceWith(`\n### ${el.textContent}\n`));box.querySelectorAll('img').forEach(el=>el.replaceWith(`\n![${el.alt||'Article image'}](${el.src})\n`));box.querySelectorAll('p').forEach(el=>el.insertAdjacentText('afterend','\n\n'));return box.textContent.replace(/\n{3,}/g,'\n\n').trim()};
$('save-post').addEventListener('click',()=>{localStorage.setItem('decuba-post-draft',JSON.stringify(collect()));$('post-status').textContent='Draft saved in this browser, including pasted images.'});$('download-post').addEventListener('click',()=>{const value=collect();if(!value['post-title'])return $('post-status').textContent='Add a title before downloading.';const markdown=`---\ntitle: "${value['post-title'].replaceAll('"','\\"')}"\ndate: ${value['post-date']||new Date().toISOString().slice(0,10)}\ncategory: "${value['post-category']}"\ndescription: "${value['post-description'].replaceAll('"','\\"')}"\nfeatureImage: "${value['post-image']}"\npublished: true\n---\n\n${htmlToMarkdown(value.content)}\n`;const blob=new Blob([markdown],{type:'text/markdown'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=`${slugify(value['post-title'])}.md`;link.click();URL.revokeObjectURL(link.href);$('post-status').textContent='Markdown ready. Pasted images are embedded in the file.'});
const aboutDraft=localStorage.getItem('decuba-about-draft');if(aboutDraft)$('about-content').value=aboutDraft;$('save-about').addEventListener('click',()=>{localStorage.setItem('decuba-about-draft',$('about-content').value);$('about-status').textContent='About draft saved in this browser.'});$('download-about').addEventListener('click',()=>{const blob=new Blob([$('about-content').value],{type:'text/plain'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='about-copy.txt';link.click();URL.revokeObjectURL(link.href);$('about-status').textContent='About copy downloaded.'});
</script>
<script is:inline>
const publish=document.createElement('button');publish.className='primary';publish.type='button';publish.textContent='Publish to site';document.querySelector('.actions').prepend(publish);publish.addEventListener('click',async()=>{const title=document.querySelector('#post-title').value.trim();if(!title)return document.querySelector('#post-status').textContent='Add a title before publishing.';const slug=title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');const text=document.querySelector('#post-content').innerText;const yaml=`---\ntitle: "${title.replaceAll('"','\\"')}"\ndate: ${document.querySelector('#post-date').value||new Date().toISOString().slice(0,10)}\ncategory: "${document.querySelector('#post-category').value}"\ndescription: "${document.querySelector('#post-description').value.replaceAll('"','\\"')}"\nfeatureImage: "${document.querySelector('#post-image').value}"\npublished: true\n---\n\n${text}\n`;publish.disabled=true;document.querySelector('#post-status').textContent='Publishing to GitHub...';const response=await fetch('/api/publish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:`${slug}.md`,content:yaml})});const result=await response.json().catch(()=>({}));publish.disabled=false;document.querySelector('#post-status').textContent=response.ok?'Published to GitHub. Cloudflare will deploy it shortly.':(result.error||'Publishing failed.')});
</script>
<script is:inline>
const duplicatePublish=[...document.querySelectorAll('.actions button')].filter(button=>button.textContent==='Publish to site');duplicatePublish.slice(1).forEach(button=>button.remove());const imageField=document.querySelector('#post-image');const imagePicker=document.createElement('input');imagePicker.type='file';imagePicker.accept='image/*';imagePicker.setAttribute('aria-label','Choose feature image');imagePicker.style.display='block';imagePicker.style.marginTop='.45rem';imageField?.parentElement?.append(imagePicker);imagePicker.addEventListener('change',()=>{const file=imagePicker.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{imageField.value=String(reader.result);document.querySelector('#post-status').textContent='Feature image selected.'};reader.readAsDataURL(file)});
</script>
<script is:inline>
setTimeout(()=>{const buttons=[...document.querySelectorAll('.actions button')].filter(button=>button.textContent==='Publish to site');buttons.slice(1).forEach(button=>button.remove())},0);
</script>
<style is:global>
.admin-shell{max-width:900px}.security-note{color:var(--pink)!important;font:500 .72rem 'DM Mono',monospace!important}.admin-head h1{font:800 clamp(2.8rem,6vw,5.8rem) 'Manrope',sans-serif;line-height:.92;letter-spacing:-.07em;max-width:10ch;margin:1rem 0}.admin-head p{color:var(--muted);font-size:1.05rem}.admin-tabs{display:flex;gap:.5rem;border-bottom:1px solid var(--line);margin:3rem 0 2rem}.admin-tabs button,.actions button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:.7rem .9rem;cursor:pointer;font:500 .7rem 'DM Mono',monospace;text-transform:uppercase}.admin-tabs button.active,.admin-tabs button:hover,.actions .primary{border-color:var(--cyan);color:var(--cyan)}.editor-panel{display:none}.editor-panel.active{display:block}.form-grid{display:grid;grid-template-columns:2fr 1fr;gap:1rem}.editor-panel label{display:block;color:var(--muted);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:1.2rem}.editor-panel input,.editor-panel select,.editor-panel textarea{display:block;width:100%;margin-top:.45rem;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:.8rem;font:400 .95rem 'Manrope',sans-serif}.editor-panel textarea{resize:vertical;line-height:1.6}.hint{color:var(--cyan);text-transform:none;margin-left:.4rem}.rich-editor{min-height:360px;margin-top:.45rem;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:1rem;font:400 .95rem 'Manrope',sans-serif;line-height:1.65;outline:0}.rich-editor:empty:before{content:attr(data-placeholder);color:var(--muted)}.rich-editor:focus{border-color:var(--cyan)}.rich-editor img{display:block;max-width:100%;height:auto;margin:1rem 0;border:1px solid var(--line)}.actions{display:flex;gap:.7rem;flex-wrap:wrap}.status{min-height:1.4rem;color:var(--lime);font:500 .7rem 'DM Mono',monospace;margin-top:1rem}@media(max-width:600px){.form-grid{grid-template-columns:1fr}}
</style>
