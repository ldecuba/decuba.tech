---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const now = new Date();
const posts = (await getCollection('posts', ({ data }) => data.published && data.date <= now)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['All topics', ...new Set(posts.flatMap((post) => post.data.categories.length ? post.data.categories : [post.data.category]))];
const series = [...new Set(posts.map((post) => post.data.series?.trim()).filter((name): name is string => Boolean(name)))].sort((a, b) => a.localeCompare(b));
const categoryIcons: Record<string, string> = {
  'Microsoft Foundry': '/images/product-icons/microsoft-foundry.svg',
  'Microsoft Copilot': '/images/product-icons/microsoft-copilot.png',
  'Copilot Studio': '/images/product-icons/copilot-studio.svg',
  'Power Platform': '/images/product-icons/power-platform.svg',
  'AI Builder': '/images/product-icons/power-platform.svg',
  'Azure AI': '/images/product-icons/azure-ai.svg',
};
---
<Base title="Techblog"><div class="filter-groups"><div class="filter-group"><span class="filter-label">Topics</span><div class="category-filters" aria-label="Filter posts by topic">{categories.map((category,index)=><button class={index===0?'active':''} data-filter-category={category}>{category}</button>)}</div></div>{series.length > 0 && <div class="filter-group"><span class="filter-label">Series</span><div class="category-filters" aria-label="Filter posts by series"><button class="active" data-filter-series="All series">All series</button>{series.map((name)=><button data-filter-series={name}>{name}</button>)}</div></div>}</div><p class="filter-empty" hidden>No articles match these filters.</p><section class="blog-grid">{posts.map(post=>{const primaryCategory=post.data.primaryCategory || post.data.category;const categoryIcon=categoryIcons[primaryCategory];return <article class="blog-card" data-post-category={(post.data.categories.length ? post.data.categories : [post.data.category]).join('|')} data-post-series={post.data.series || ''}><a class="card-image" href={`/posts/${post.id}`}><img class="card-art" src={post.data.featureImage} alt={post.data.featureImageAlt || ''} />{categoryIcon && <span class="category-icon" aria-hidden="true"><img src={categoryIcon} alt="" /></span>}</a><div class="blog-card-body"><div class="card-top"><div class="meta">{primaryCategory}</div><span class={`level level-${post.data.level.toLowerCase()}`}>{post.data.level}</span></div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="card-footer"><span>{post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</span><a href={`/posts/${post.id}`}>Read article →</a></div></div></article>})}</section></Base>
<script>
const topicFilters=document.querySelectorAll('[data-filter-category]');const seriesFilters=document.querySelectorAll('[data-filter-series]');const cards=document.querySelectorAll('[data-post-category]');const emptyState=document.querySelector('.filter-empty');let activeTopic='All topics';let activeSeries='All series';const filterCards=()=>{let visible=0;cards.forEach(card=>{const topicMatch=activeTopic==='All topics'||card.dataset.postCategory.split('|').includes(activeTopic);const seriesMatch=activeSeries==='All series'||card.dataset.postSeries===activeSeries;card.hidden=!(topicMatch&&seriesMatch);if(!card.hidden)visible+=1});if(emptyState)emptyState.hidden=visible>0};topicFilters.forEach(filter=>filter.addEventListener('click',()=>{activeTopic=filter.dataset.filterCategory;topicFilters.forEach(item=>item.classList.toggle('active',item===filter));filterCards()}));seriesFilters.forEach(filter=>filter.addEventListener('click',()=>{activeSeries=filter.dataset.filterSeries;seriesFilters.forEach(item=>item.classList.toggle('active',item===filter));filterCards()}));
</script>
<style is:global>
.blog-intro{max-width:820px}.blog-intro h1{max-width:12ch}.filter-groups{display:grid;gap:1rem;margin:0 0 2rem}.filter-group{display:grid;grid-template-columns:5rem minmax(0,1fr);gap:1rem;align-items:start}.filter-label{padding-top:.7rem;color:var(--muted);font:600 .68rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.category-filters{display:flex;flex-wrap:wrap;gap:.55rem}.category-filters button{border:1px solid var(--line);border-radius:2rem;background:var(--panel);color:var(--muted);padding:.65rem .9rem;cursor:pointer;font-size:.72rem;font-weight:650}.category-filters button:hover,.category-filters button.active{border-color:var(--accent);background:var(--accent);color:#fff}.filter-empty{padding:1.2rem;border:1px solid var(--line);background:var(--panel);color:var(--muted)}.blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.blog-card{border:1px solid var(--line);border-radius:.9rem;background:var(--panel);min-width:0;overflow:hidden;transition:transform .2s,box-shadow .2s}.blog-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(27,46,83,.11)}.blog-card[hidden]{display:none}.card-image{position:relative;display:block;overflow:hidden}.card-art{display:block;width:100%;height:180px;object-fit:cover;transition:transform .3s}.blog-card:hover .card-art{transform:scale(1.025)}.category-icon{position:absolute;top:.8rem;right:.8rem;display:grid;width:46px;height:46px;place-items:center;border:1px solid rgba(255,255,255,.22);border-radius:.7rem;background:rgba(8,13,25,.72);box-shadow:0 8px 24px rgba(0,0,0,.24);backdrop-filter:blur(8px)}.category-icon img{display:block;width:27px;height:27px;object-fit:contain}.blog-card-body{padding:1.25rem;min-height:290px;display:flex;flex-direction:column}.card-top,.card-footer{display:flex;justify-content:space-between;gap:1rem;align-items:center}.blog-card h2{font-size:1.4rem;line-height:1.18;letter-spacing:-.04em;margin:1rem 0 .6rem}.blog-card p{color:var(--muted);line-height:1.6;margin:0 0 1.4rem}.card-footer{margin-top:auto;padding-top:1rem;border-top:1px solid var(--line);font-size:.72rem;color:var(--muted)}.card-footer a{color:var(--accent);font-weight:700}@media(max-width:850px){.blog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.filter-group{grid-template-columns:1fr;gap:.2rem}.filter-label{padding-top:0}.blog-grid{grid-template-columns:1fr}.card-art{height:200px}}
</style>
<style is:global>.level{display:inline-block;color:var(--accent);font:500 .62rem 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.06em}</style>
