---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('posts', ({ data }) => data.published); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = post.data.bodyHtml ? { Content: null } : await render(post);
const title = post.data.title;
const date = post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
const richText = (value) => { if (!value) return ''; const hasStructure=/<(h[1-6]|ul|ol|li|blockquote|img|hr)\b/i.test(value); if (/<[a-z][\s\S]*>/i.test(value) && hasStructure) return value.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/\*([^*]+)\*/g,'<em>$1</em>'); const plain=value.replace(/<br\s*\/?>/gi,'\n').replace(/<\/div>\s*<div[^>]*>/gi,'\n\n').replace(/<\/?(?:div|p)[^>]*>/gi,''); return plain.split(/\n\s*\n/).map(block => { const lines=block.split('\n').map(line=>line.trim()).filter(Boolean); const bulletLines=lines.length===1&&/^\s*[-*]\s+/.test(lines[0])&&lines[0].slice(2).split(/\s+[-*]\s+/).filter(Boolean); if(lines.every(line=>/^\s*[-*]\s+/.test(line))) return `<ul>${lines.map(line=>`<li>${line.replace(/^\s*[-*]\s+/,'')}</li>`).join('')}</ul>`; if(bulletLines?.length>1) return `<ul>${bulletLines.map(line=>`<li>${line.trim()}</li>`).join('')}</ul>`; if(/^###\s+/.test(block)) return `<h3>${block.replace(/^###\s+/,'')}</h3>`; if(/^##\s+/.test(block)) return `<h2>${block.replace(/^##\s+/,'')}</h2>`; return `<p>${block.replace(/\n/g,'<br />').replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/\*([^*]+)\*/g,'<em>$1</em>')}</p>`; }).join(''); };
const bodyHtml = post.data.bodyHtml ? richText(post.data.bodyHtml) : '';
---
<Base title={title}><article><div class="article-meta">{post.data.primaryCategory || post.data.category} · {date}</div><img class="feature-image" src={post.data.featureImage} alt="" /><h1>{title}</h1><div class="article-tags"><span>{post.data.series ? `Series: ${post.data.series}` : 'Field note'}</span><span>Level: {post.data.level}</span><span>Read / 06 min</span></div><div class="article-body">{post.data.bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}</div></article></Base>
<style>.feature-image{display:block;width:100%;height:auto;max-height:620px;object-fit:contain;object-position:center;border:1px solid var(--cyan);margin:2rem 0 1rem}.article h1,article h1{font-size:clamp(2rem,4vw,4rem);line-height:.98;letter-spacing:-.055em;max-width:18ch;margin:1rem 0 2rem}.article-tags{display:flex;gap:1rem;color:var(--lime);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;margin-bottom:2rem}@media(max-width:760px){.feature-image{max-height:none}.article h1,article h1{font-size:clamp(2rem,9vw,3.2rem)}}
</style>
