---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const now = new Date(); const posts = await getCollection('posts', ({ data }) => data.published && data.date <= now); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = post.data.bodyHtml ? { Content: null } : await render(post);
const title = post.data.title;
const date = post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
const inlineMarkdown = (value) => value.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<em>$2</em>');
const richText = (value) => { if (!value) return ''; const hasStructure=/<(h[1-6]|ul|ol|li|blockquote|img|hr|figure|pre|p)\b/i.test(value); if (/<[a-z][\s\S]*>/i.test(value) && hasStructure) return inlineMarkdown(value); const plain=value.replace(/<br\s*\/?>/gi,'\n').replace(/<\/div>\s*<div[^>]*>/gi,'\n\n').replace(/<\/?(?:div|p)[^>]*>/gi,''); return plain.split(/\n\s*\n/).map(block => { const lines=block.split('\n').map(line=>line.trim()).filter(Boolean); if(lines.every(line=>/^\s*[-*]\s+/.test(line))) return `<ul>${lines.map(line=>`<li>${line.replace(/^\s*[-*]\s+/,'')}</li>`).join('')}</ul>`; if(/^###\s+/.test(block)) return `<h3>${block.replace(/^###\s+/,'')}</h3>`; if(/^##\s+/.test(block)) return `<h2>${block.replace(/^##\s+/,'')}</h2>`; return `<p>${inlineMarkdown(block.replace(/\n/g,'<br />'))}</p>`; }).join(''); };
const repairListMarkup = (value) => value.replace(/<ul[^>]*>([\s\S]*?)<\/ul>/gi,(_,inner)=>'<ul>'+inner.split(/\s+-\s+/).map(item=>item.trim()).filter(Boolean).map(item=>'<li>'+item+'</li>').join('')+'</ul>');
const bodyHtml = post.data.bodyHtml ? richText(repairListMarkup(post.data.bodyHtml)) : '';
---
<Base title={post.data.seoTitle || title}><article class="article"><header class="article-header"><div class="article-meta">{post.data.primaryCategory || post.data.category} · {date}</div><h1>{title}</h1><p class="article-dek">{post.data.description}</p><div class="article-tags"><span>{post.data.series ? `Series: ${post.data.series}` : 'Field note'}</span><span>Level: {post.data.level}</span>{post.data.tags.map((tag)=><span>#{tag}</span>)}</div></header><img class="feature-image" src={post.data.featureImage} alt={post.data.featureImageAlt || ''} /><div class="article-body">{post.data.bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}</div></article><dialog class="image-viewer" aria-label="Enlarged image"><button class="image-viewer-close" type="button" aria-label="Close enlarged image">×</button><img src="" alt="" /></dialog></Base>
<script>
const article = document.querySelector('.article');
const viewer = document.querySelector('.image-viewer');
const viewerImage = viewer?.querySelector('img');
const closeButton = viewer?.querySelector('.image-viewer-close');
let sourceImage;

const openViewer = (image) => {
  if (!(viewer instanceof HTMLDialogElement) || !(viewerImage instanceof HTMLImageElement)) return;
  sourceImage = image;
  viewerImage.src = image.currentSrc || image.src;
  viewerImage.alt = image.alt || '';
  viewer.showModal();
  document.documentElement.classList.add('image-viewer-open');
  closeButton?.focus();
};

article?.querySelectorAll('img').forEach((image) => {
  image.tabIndex = 0;
  image.setAttribute('role', 'button');
  image.setAttribute('aria-label', image.alt ? `Enlarge image: ${image.alt}` : 'Enlarge image');
  image.addEventListener('click', () => openViewer(image));
  image.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      openViewer(image);
    }
  });
});

closeButton?.addEventListener('click', () => viewer?.close());
viewer?.addEventListener('click', (event) => {
  if (event.target === viewer) viewer.close();
});
viewer?.addEventListener('close', () => {
  document.documentElement.classList.remove('image-viewer-open');
  sourceImage?.focus();
});
</script>
<style>.article{width:100%;max-width:1080px;margin:0 auto}.article-header{max-width:900px}.article h1{font-size:clamp(2.6rem,6vw,5.7rem);line-height:.98;letter-spacing:-.07em;max-width:16ch;margin:1rem 0 1.4rem}.article-dek{max-width:760px;color:var(--muted);font-size:1.2rem;line-height:1.7;margin:0 0 1.6rem}.feature-image{display:block;width:100%;height:auto;max-height:680px;object-fit:contain;object-position:center;border-radius:1rem;background:var(--panel);margin:3rem 0}.article-tags{display:flex;gap:.55rem;flex-wrap:wrap;color:var(--accent);font:500 .68rem 'IBM Plex Mono',monospace;text-transform:uppercase}.article-tags span{padding:.45rem .6rem;border-radius:2rem;background:var(--accent-soft)}.article-body{width:100%;max-width:none;color:var(--muted);font-size:1.08rem;line-height:1.85}.article-body p,.article-body ul,.article-body ol,.article-body blockquote,.article-body pre{width:100%;max-width:820px}.article-body h2,.article-body h3{max-width:820px}.article-body img{display:block;width:100%;max-width:100%;height:auto;max-height:760px;object-fit:contain;margin:2rem auto;border-radius:.75rem}.article-body figure{width:100%;margin:2rem 0}.article-body figcaption{text-align:center;color:var(--muted);font-size:.8rem;margin-top:.5rem}.article-body blockquote{border-left:3px solid var(--accent);padding:1rem 1.25rem;background:var(--panel);color:var(--muted)}.article-body pre{overflow:auto;padding:1.2rem;border-radius:.75rem;background:#101827;color:#e6edf7;border:1px solid var(--line)}.article img[role='button']{cursor:zoom-in}.article img[role='button']:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.image-viewer{width:100vw;height:100vh;max-width:none;max-height:none;margin:0;padding:clamp(1rem,4vw,3rem);border:0;background:rgba(5,10,20,.94);overflow:hidden}.image-viewer[open]{display:grid;place-items:center}.image-viewer::backdrop{background:rgba(5,10,20,.94)}.image-viewer img{display:block;max-width:100%;max-height:calc(100vh - clamp(2rem,8vw,6rem));object-fit:contain}.image-viewer-close{position:fixed;z-index:1;top:clamp(.75rem,2vw,1.5rem);right:clamp(.75rem,2vw,1.5rem);display:grid;width:2.75rem;height:2.75rem;padding:0;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:rgba(5,10,20,.72);color:#fff;font-size:2rem;line-height:1;cursor:pointer}.image-viewer-close:hover,.image-viewer-close:focus-visible{background:#fff;color:#07101f}.image-viewer-close:focus-visible{outline:3px solid #78aaff;outline-offset:3px}:global(html.image-viewer-open){overflow:hidden}@media(max-width:760px){.feature-image,.article-body img{max-height:none}.article h1{font-size:clamp(2.2rem,11vw,3.8rem)}}
</style>
