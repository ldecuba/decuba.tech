---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const now = new Date(); const posts = await getCollection('posts', ({ data }) => data.published && data.date <= now); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = post.data.bodyHtml ? { Content: null } : await render(post);
const title = post.data.title;
const date = post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
const inlineMarkdown = (value) => value.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<em>$2</em>');
const richText = (value) => { if (!value) return ''; const hasStructure=/<(h[1-6]|ul|ol|li|blockquote|img|hr|figure|pre|p)\b/i.test(value); if (/<[a-z][\s\S]*>/i.test(value) && hasStructure) return inlineMarkdown(value); const plain=value.replace(/<br\s*\/?>/gi,'\n').replace(/<\/div>\s*<div[^>]*>/gi,'\n\n').replace(/<\/?(?:div|p)[^>]*>/gi,''); return plain.split(/\n\s*\n/).map(block => { const lines=block.split('\n').map(line=>line.trim()).filter(Boolean); if(lines.every(line=>/^\s*[-*]\s+/.test(line))) return `<ul>${lines.map(line=>`<li>${line.replace(/^\s*[-*]\s+/,'')}</li>`).join('')}</ul>`; if(/^###\s+/.test(block)) return `<h3>${block.replace(/^###\s+/,'')}</h3>`; if(/^##\s+/.test(block)) return `<h2>${block.replace(/^##\s+/,'')}</h2>`; return `<p>${inlineMarkdown(block.replace(/\n/g,'<br />'))}</p>`; }).join(''); };
const repairListMarkup = (value) => value.replace(/<ul[^>]*>([\s\S]*?)<\/ul>/gi,(_,inner)=>'<ul>'+inner.split(/\s+-\s+/).map(item=>item.trim()).filter(Boolean).map(item=>'<li>'+item+'</li>').join('')+'</ul>');
const bodyHtml = post.data.bodyHtml ? richText(repairListMarkup(post.data.bodyHtml)) : '';
---
<Base title={post.data.seoTitle || title}><article class="article"><header class="article-header"><div class="article-meta">{post.data.primaryCategory || post.data.category} · {date}</div><h1>{title}</h1><p class="article-dek">{post.data.description}</p><div class="article-tags"><span>{post.data.series ? `Series: ${post.data.series}` : 'Field note'}</span><span>Level: {post.data.level}</span>{post.data.tags.map((tag)=><span>#{tag}</span>)}</div></header><img class="feature-image" src={post.data.featureImage} alt={post.data.featureImageAlt || ''} /><div class="article-body">{post.data.bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}</div></article></Base>
<style>.article{width:100%;max-width:1080px;margin:0 auto}.article-header{max-width:920px}.article h1{font-size:clamp(2.5rem,6vw,5.6rem);line-height:.95;letter-spacing:-.065em;max-width:16ch;margin:1rem 0 1.25rem}.article-dek{max-width:760px;color:var(--muted);font-size:1.15rem;line-height:1.65;margin:0 0 1.5rem}.feature-image{display:block;width:100%;height:auto;max-height:680px;object-fit:contain;object-position:center;border:1px solid var(--cyan);margin:2rem 0}.article-tags{display:flex;gap:.65rem 1rem;flex-wrap:wrap;color:var(--lime);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase}.article-body{width:100%;max-width:none;color:#c2cbd7;font-size:1.08rem;line-height:1.82}.article-body p,.article-body ul,.article-body ol,.article-body blockquote,.article-body pre{width:100%;max-width:920px}.article-body h2,.article-body h3{max-width:920px}.article-body img{display:block;width:100%;max-width:100%;height:auto;max-height:760px;object-fit:contain;margin:1.8rem auto}.article-body figure{width:100%;margin:2rem 0}.article-body figcaption{text-align:center;color:var(--muted);font-size:.8rem;margin-top:.5rem}.article-body blockquote{border-left:3px solid var(--pink);padding-left:1.25rem;color:var(--muted)}.article-body pre{overflow:auto;padding:1rem;background:#080c12;border:1px solid var(--line)}@media(max-width:760px){.feature-image,.article-body img{max-height:none}.article h1{font-size:clamp(2.2rem,11vw,3.8rem)}}
</style>
